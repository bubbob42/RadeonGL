FailAt 21
Stack 100000
Echo "GLBench: seven scenes, then the score."
Echo "Esc ends it, the space bar skips a scene. The result also goes"
Echo "to RAM:GLBench-Result.txt."
CPU CHECK 68881 >NIL:
If WARN
  Echo "GLBench needs a 68881, a 68882 or a 68040/68060 FPU."
  Quit 20
EndIf
CPU CHECK 68040 >NIL:
If WARN
  C/GLBench030
Else
  C/GLBench
EndIf
