; Install -- Commodore/Amiga Installer script for @PROJECT_NAME@
; =========================================================================
; Installs @PROJECT_NAME@ on a real AmigaOS 3.x system. Written for the V44
; Installer (works on V42+). See docs/installer-scripting.md for the language.
;
; This is a GENERIC starter template: @PROJECT_NAME@ is substituted by the
; Makefile's `installer` target. Extend it for your project (localisation,
; fonts, extra data files -- see the commented examples at the bottom).
;
; It ships in the dist/ tree (staged by `gmake installer`, pushed by
; `gmake push`) and runs from there -- on the Amiga, double-click the "Install"
; icon (its default tool is Installer). All (source ...) paths below are
; relative to that drawer. It copes with two layouts:
;
;   * the build/push tree, which carries BOTH compiler builds
;       @PROJECT_NAME@_gcc(.info)  @PROJECT_NAME@_sasc(.info)
;   * a clean release drawer, which carries a single renamed
;       @PROJECT_NAME@(.info)
;
; The chosen program is always installed as "@PROJECT_NAME@".
; =========================================================================

(welcome "This will install @PROJECT_NAME@ onto your system.\n")

; --- system requirements ---------------------------------------------------
; Minimum AmigaOS version. V37 (2.04) is a safe floor for a plain application;
; RAISE this to 39 (3.0) for a ReAction/Intuition GUI. getversion with no file
; returns the OS version as (version << 16 | revision).
(set #minos 37)
(set #os (/ (getversion) 65536))
(if (< #os #minos)
    (abort ("@PROJECT_NAME@ requires AmigaOS V%ld or newer.\n"
            "This system reports Kickstart V%ld.\n" #minos #os))
)

; --- which program file to install -----------------------------------------
; A clean release ships one "@PROJECT_NAME@"; the build tree ships two builds,
; so let the user pick. Either way #binary names the file to copy (its icon
; copies with it via (infos), renamed to @PROJECT_NAME@.info by (newname)).
(if (exists "@PROJECT_NAME@")
    (set #binary "@PROJECT_NAME@")
    (
        (set #pick
            (askchoice
                (prompt "Which build of @PROJECT_NAME@ should be installed?")
                (help "Both do the same thing. GCC is the default; SAS/C is "
                      "the classic native-compiler build. If unsure, keep GCC.\n\n"
                      @askchoice-help)
                (choices "GCC (68000)" "SAS/C 6.58")
                (default 0))
        )
        ; askchoice returns a one-bit mask: bit0 -> GCC, bit1 -> SAS/C.
        (if (= #pick 2)
            (set #binary "@PROJECT_NAME@_sasc")
            (set #binary "@PROJECT_NAME@_gcc"))
    )
)
(if (= (exists #binary) 0)
    (abort ("The program file '%s' is missing from this drawer.\n" #binary))
)

; --- choose the destination ------------------------------------------------
(set #where
    (askdir
        (prompt "In which drawer should @PROJECT_NAME@ be installed?\n"
                "A new '@PROJECT_NAME@' drawer will be created inside it.")
        (help "Select the drawer that will hold the new @PROJECT_NAME@ drawer, "
              "for example Work: or SYS:Tools.\n\n"
              @askdir-help)
        (default @default-dest)
    )
)
(set #dest (tackon #where "@PROJECT_NAME@"))
(makedir #dest
    (prompt ("Creating the drawer\n%s" #dest))
    (help @makedir-help)
    (infos)
)
(set @default-dest #dest)          ; so the summary + log point at the real place

; --- the program and its icon (installed as "@PROJECT_NAME@") ---------------
(copyfiles
    (prompt "Copying the @PROJECT_NAME@ program.")
    (help "This copies the program and its icon into the new drawer.\n\n"
          @copyfiles-help)
    (source #binary)
    (dest #dest)
    (newname "@PROJECT_NAME@")      ; rename the build to the plain name
    (infos)                        ; carries the icon, renamed to match
)

; --- online help (optional) ------------------------------------------------
; A GUI app typically looks for PROGDIR:@PROJECT_NAME@.guide first, then HELP:.
; Installing it into the program drawer satisfies the PROGDIR: search and keeps
; the app self-contained. Help is not essential, so a copy failure is not fatal.
(if (exists "@PROJECT_NAME@.guide")
    (copyfiles
        (prompt "Copying the online help.")
        (help @copyfiles-help)
        (source "@PROJECT_NAME@.guide")
        (dest #dest)
        (optional "nofail")
    )
)

; --- done ------------------------------------------------------------------
(complete 100)
(exit "@PROJECT_NAME@ has been installed into\n\n    " #dest "\n\n"
      "Open that drawer and double-click the @PROJECT_NAME@ icon to start.")

; =========================================================================
; EXTENDING THIS SCRIPT (examples -- see docs/installer-scripting.md)
;
; Message catalog into the system locale tree (so the app localises itself):
;   (if (exists "Catalogs/deutsch/@PROJECT_NAME@.catalog")
;       (copyfiles
;           (prompt "Copying the German message catalog.")
;           (source "Catalogs/deutsch/@PROJECT_NAME@.catalog")
;           (dest "LOCALE:Catalogs/deutsch")
;           (optional "nofail")))
;
; Bitmap fonts into the system FONTS: drawer:
;   (if (exists "Fonts")
;       (copyfiles (source "Fonts") (dest "FONTS:") (all) (optional "nofail")))
; =========================================================================
