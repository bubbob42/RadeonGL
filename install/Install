; Install -- Commodore/Amiga Installer script for RadeonGL
; =========================================================================
; Installs RadeonGL's minigl.library into LIBS: and a RadeonGL drawer (the
; manuals, the card test, the card report, the licences) wherever the user
; chooses. Written for the V44 Installer of AmigaOS 3.2. It runs from the
; package drawer: every (source ...) path is relative to it, and the files
; it installs wait in Files/, which has no icon and stays out of sight.
;
;   Files/Libs/minigl.library   -> LIBS:  (the 68040/68060 build)
;   Files/68030/Libs/minigl.library -> LIBS:  (or the 68020/68030 build)
;   Files/RadeonGL/#?           -> <chosen drawer>/RadeonGL/
;   Files/68030/C, Demos/C      -> over its C and Demos/C (the 68030 build)
;
; The library replaces any minigl.library in LIBS:. One that is NOT
; RadeonGL's (Search finds no "RadeonGL" in it) is kept first, renamed to
; minigl.library.old, or .old1 when an .old is there already; with both
; there the installation stops rather than lose a library.
; NOT (copylib): it keeps an installed file whose version is not older, and
; every minigl.library 29.1 (PiStorm3D's, RadeonGL's) has the same version.
;
; NOVICE asks nothing (the Installer's own rule, MEASURED on 3.2): every ask
; below has a nested-if novice default.
;
; Measured traps (docs/installer-scripting.md; tools/check_installer.py
; catches the mechanical ones before staging):
; WARNING: askchoice answers the CHOICE NUMBER from 0, not a bit mask.
; WARNING: (OR ...) and (AND ...) evaluate every argument.
; WARNING: compare CPUs with (database "cpu" "68060"), the exact form.
; WARNING: never (exists "Vol:") for a volume that may not be mounted;
; (getassign "Work" "av") reads the list in memory.
; WARNING: one substitution per parenthesis pair; join strings with (cat).
; WARNING: (run) does nothing in Pretend mode unless it is (safe).
; =========================================================================

(welcome "This will install RadeonGL, a minigl.library for the ATI Radeon "
         "8500, 9000, 9100, 9200 and 9250 on Picasso96, on your system.\n")

(set #minos 40)
(set #os (/ (getversion) 65536))
(if (< #os #minos)
    (abort ("RadeonGL requires AmigaOS 3.1 (V%ld) or newer.\n" #minos)
           ("This system reports Kickstart V%ld.\n" #os))
)

; --- the CPU and its FPU ---------------------------------------------------
; Two builds (the user, 2026-11-03): the 68040/68060 one (GCC -m68060: FPU
; instructions a 68881/68882 does not know) and the 68020/68030 one for a
; 68881/68882 (-m68030), with its own GLSmoke and demos. Each refuses to
; open on a CPU it cannot run on (lib/shell.c). Without an FPU, neither.
(if (database "fpu" "NOFPU")
    (abort "RadeonGL needs a CPU with a floating-point unit (FPU).\n\n"
           "This system has none. RadeonGL runs on a 68040 or 68060, or on "
           "a 68020 or 68030 with a 68881 or 68882.")
)
(set #for030 0)
(if (database "cpu" "68020") (set #for030 1))
(if (database "cpu" "68030") (set #for030 1))
(if (= @user-level 0)
    (set #build #for030)
    (set #build
        (askchoice
            (prompt "Which minigl.library should be installed?\n"
                    "The Installer has chosen the one for this CPU.")
            (help "RadeonGL comes in two builds. The one for the 68040 and "
                  "68060 uses FPU instructions that a 68881 or 68882 does "
                  "not have. The other runs on a 68020 or 68030 with a "
                  "68881 or 68882 (and on a 68040 or 68060 too, a little "
                  "slower). A build on a CPU it cannot run on does not "
                  "open at all.\n\n" @askchoice-help)
            (choices "For the 68040 and 68060"
                     "For a 68020 or 68030 with a 68881 or 68882")
            (default #for030)
        )
    )
)
(set #libsrc "Files/Libs/minigl.library")
(set #buildname "68040/68060")
(if (= #build 1)
    (
        (set #libsrc "Files/68030/Libs/minigl.library")
        (set #buildname "68020/68030")
    )
)

; --- Picasso96 and its Radeon driver ---------------------------------------
(set #p96 0)
(if (exists "LIBS:Picasso96API.library")
    (set #p96 (/ (getversion "LIBS:Picasso96API.library") 65536)))
(if (< #p96 2)
    (abort "RadeonGL draws through Picasso96, which is not installed "
           "(there is no LIBS:Picasso96API.library).\n\n"
           "Install Picasso96 3.6 or newer with its Radeon driver first.")
)
(if (= (exists "LIBS:Picasso96/Radeon.card") 0)
    (message "There is no Radeon driver in LIBS:Picasso96 (Radeon.card).\n\n"
             "RadeonGL needs a Radeon 8500, 9000, 9100, 9200 or 9250 that "
             "Picasso96 drives with its Radeon driver. Without one, programs "
             "that use minigl.library show a small RadeonGL window instead "
             "of a picture.\n\n"
             "You can install it anyway, or stop the installation here."
             (all))
)

; --- the library -----------------------------------------------------------
(set #kept "")
(if (exists "LIBS:minigl.library")
    (if (<> 0 (run "Search >NIL: LIBS:minigl.library RadeonGL QUIET" (safe)))
        (
            (set #keep "LIBS:minigl.library.old")
            (if (exists #keep) (set #keep "LIBS:minigl.library.old1"))
            (if (exists #keep)
                (abort "LIBS: holds a minigl.library that is not RadeonGL's, and "
                       "LIBS:minigl.library.old and LIBS:minigl.library.old1 are "
                       "there already.\n\n"
                       "So that none of them is lost, the installation stops here. "
                       "Move one of the two away, then install again.")
            )
            ; (rename) answers 1 or 0 (it fails across the volumes of a
            ; multi-assign LIBS:); in Pretend mode it renames nothing
            (set #renamed
                (rename "LIBS:minigl.library" #keep
                    (prompt ("Your minigl.library is kept as %s." #keep))
                    (help "The minigl.library in LIBS: is not RadeonGL's. It is "
                          "renamed, not deleted, so you can go back to it: see "
                          "the RadeonGL manual.")
                )
            )
            (if (= @pretend 0)
                (if (= #renamed 0)
                    (abort "LIBS:minigl.library, which is not RadeonGL's, could "
                           ("not be renamed to %s.\n\n" #keep)
                           "So that it is not lost, the installation stops here. "
                           "Move it away yourself, then install again.")
                )
            )
            (set #kept #keep)
        )
    )
)
(copyfiles
    (prompt "Installing minigl.library into LIBS:.")
    (help "minigl.library is how programs such as GLQuake reach the Radeon's "
          "3D engine.\n\n" @copyfiles-help)
    (source #libsrc)
    (dest "LIBS:")
    (optional "force")
)
; a library stays in memory until it is flushed: without this, the next
; program would still meet the old one
(run "Avail >NIL: FLUSH")
(run "Avail >NIL: FLUSH")

; --- the RadeonGL drawer ---------------------------------------------------
(set #defbase "SYS:")
(if (= (exists "SYS:Utilities" (noreq)) 2) (set #defbase "SYS:Utilities"))
(if (NOT (= (getassign "Work" "av") "")) (set #defbase "Work:"))
(if (= @user-level 0)
    (set #where #defbase)
    (set #where
        (askdir
            (prompt "Where should the RadeonGL drawer go?\n"
                    "It holds the manuals, the card test, the demos and the licences.")
            (help "Select the drawer that will hold the new RadeonGL drawer, "
                  "for example Work: or SYS:Utilities. The library itself "
                  "always goes into LIBS:.\n\n"
                  @askdir-help)
            (default #defbase)
        )
    )
)
(set #dest (tackon #where "RadeonGL"))
(makedir #dest
    (prompt ("Creating the drawer\n%s" #dest))
    (help @makedir-help)
)
(set @default-dest #dest)
; the drawer's own icon, with its window and icon positions: a drawer
; without one is invisible in an icon view
(copyfiles
    (prompt "Copying the drawer's icon.")
    (help @copyfiles-help)
    (source "Files/RadeonGL.info")
    (dest #where)
    (optional "force")
)
(copyfiles
    (prompt "Copying the manuals, the card test, the demos and the licences.")
    (help "Test runs a short 3D test on the Radeon and shows the frame "
          "rate; CardReport writes a report of the card for bug reports. "
          "Both only read the card's settings.\n\n" @copyfiles-help)
    (source "Files/RadeonGL")
    (dest #dest)
    (all)
    (infos)
    (optional "force")
)
; the 68020/68030 build's own GLSmoke and demos over the 68040/68060 ones
(if (= #build 1)
    (
        (copyfiles
            (prompt "Copying the card test for the 68020/68030.")
            (help @copyfiles-help)
            (source "Files/68030/C")
            (dest (tackon #dest "C"))
            (all)
            (optional "force")
        )
        (copyfiles
            (prompt "Copying the demos for the 68020/68030.")
            (help @copyfiles-help)
            (source "Files/68030/Demos/C")
            (dest (tackon #dest "Demos/C"))
            (all)
            (optional "force")
        )
    )
)

; --- the command check -----------------------------------------------------
; RadeonGLCheck=0 turns the checker off; nothing (the library's default)
; keeps it on. A choice of "on" removes an old "0". The default is what is
; set now, so a reinstall at NOVICE keeps a user's RadeonGLCheck=0.
(set #checknow 0)
(if (= (getenv "RadeonGLCheck") "0") (set #checknow 1))
(if (= @user-level 0)
    (set #check #checknow)
    (set #check
        (askchoice
            (prompt "Should RadeonGL check every list of commands before "
                    "the Radeon runs it?")
            (help "The check stops a faulty command list before it can hang "
                  "the graphics card. It costs about a fifth of the frame "
                  "rate (GLQuake on a 68060: 19 instead of 24 frames a "
                  "second). You can change this later with the RadeonGLCheck "
                  "variable: see the manual.\n\n" @askchoice-help)
            (choices "Check (safe)" "Do not check (faster)")
            (default #checknow)
        )
    )
)
(if (= #check 1)
    (
        (textfile (prompt "Turning the command check off.")
                  (help "RadeonGLCheck=0 in ENVARC: and ENV:.")
                  (dest "ENVARC:RadeonGLCheck") (append "0"))
        (textfile (prompt "Turning the command check off.")
                  (help "RadeonGLCheck=0 in ENVARC: and ENV:.")
                  (dest "ENV:RadeonGLCheck") (append "0"))
    )
    (
        (if (exists "ENVARC:RadeonGLCheck")
            (delete "ENVARC:RadeonGLCheck" (optional "force")))
        (if (exists "ENV:RadeonGLCheck")
            (delete "ENV:RadeonGLCheck" (optional "force")))
    )
)

; --- done ------------------------------------------------------------------
(complete 100)
(set #closing
    (cat ("RadeonGL's minigl.library (for the %s) is in LIBS:.\n\n" #buildname)
         ("Your previous minigl.library is kept as %s.\n\n" #kept)
         ("The manuals, the card test, the demos and the licences are in\n%s\n\n" #dest)
         "Double-click Test there to see the Radeon draw, and look in Demos."))
(if (= #kept "")
    (set #closing
        (cat ("RadeonGL's minigl.library (for the %s) is in LIBS:.\n\n" #buildname)
             ("The manuals, the card test, the demos and the licences are in\n%s\n\n" #dest)
             "Double-click Test there to see the Radeon draw, and look in Demos.")))
(exit #closing)
