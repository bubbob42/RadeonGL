; ProbeSmoke -- the probes (GCC and SAS/C builds, CPRing and Tri too) refuse cleanly where there is no PCI bridge:
; FS-UAE has no openpci.library, so both must print the "not found" line,
; write their log and exit with rc 20, touching nothing. (The real runs
; happen on the A4000D; see docs/probes.md.)
; LIMIT 120
FailAt 1000
Wait 12
Echo "=== machine ===" >DEV:Test/auto.log
CPU >>DEV:Test/auto.log
Echo "=== R200Info ===" >>DEV:Test/auto.log
DEV:Probe/C/R200Info LOG=DEV:Test/probe-r200info.log >>DEV:Test/auto.log
Echo "rc=$RC" >>DEV:Test/auto.log
Type DEV:Test/probe-r200info.log >>DEV:Test/auto.log
Echo "=== BusBench ===" >>DEV:Test/auto.log
DEV:Probe/C/BusBench LOG=DEV:Test/probe-busbench.log >>DEV:Test/auto.log
Echo "rc=$RC" >>DEV:Test/auto.log
Type DEV:Test/probe-busbench.log >>DEV:Test/auto.log
Echo "=== R200Info_sasc ===" >>DEV:Test/auto.log
DEV:Probe/C/R200Info_sasc LOG=DEV:Test/probe-r200info-sasc.log >>DEV:Test/auto.log
Echo "rc=$RC" >>DEV:Test/auto.log
Echo "=== BusBench_sasc ===" >>DEV:Test/auto.log
DEV:Probe/C/BusBench_sasc LOG=DEV:Test/probe-busbench-sasc.log >>DEV:Test/auto.log
Echo "rc=$RC" >>DEV:Test/auto.log
Echo "=== CPRing ===" >>DEV:Test/auto.log
DEV:Probe/C/CPRing LOG=DEV:Test/probe-cpring.log >>DEV:Test/auto.log
Echo "rc=$RC" >>DEV:Test/auto.log
Type DEV:Test/probe-cpring.log >>DEV:Test/auto.log
Echo "=== CPRing_sasc ===" >>DEV:Test/auto.log
DEV:Probe/C/CPRing_sasc LOG=DEV:Test/probe-cpring-sasc.log >>DEV:Test/auto.log
Echo "rc=$RC" >>DEV:Test/auto.log
Echo "=== Tri ===" >>DEV:Test/auto.log
DEV:Probe/C/Tri LOG=DEV:Test/probe-tri.log NOSHOW >>DEV:Test/auto.log
Echo "rc=$RC" >>DEV:Test/auto.log
Echo "=== Tri_sasc ===" >>DEV:Test/auto.log
DEV:Probe/C/Tri_sasc LOG=DEV:Test/probe-tri-sasc.log NOSHOW >>DEV:Test/auto.log
Echo "rc=$RC" >>DEV:Test/auto.log
Echo "=== IconX scripts (Execute) ===" >>DEV:Test/auto.log
Execute DEV:Probe/R200Info >>DEV:Test/auto.log
Echo "rc=$RC" >>DEV:Test/auto.log
Echo "=== done ===" >>DEV:Test/auto.log
Echo >DEV:Test/AutoDone done
