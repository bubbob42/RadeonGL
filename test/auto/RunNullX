.KEY demo/A,extra/F
.BRA {
.KET }
; RunNullX -- RunNull with extra GLQuake arguments (for instance
; -extensions, which turns on GLQuake's multitexture path): timedemo
; {demo} on the null card, logs DEV:Test/nullx-{demo}.log and
; DEV:Test/nullx-{demo}-lib.log, a done marker at the end.
; -anycpu: FS-UAE's machine is a 68040 and GLQuake the 68060 build, which
; refuses another CPU since 2026-11-06 (it ran there emulating FINTRZ before).
FailAt 1000
CD DEV:Quake
SetEnv RadeonGLLog DEV:Test/nullx-{demo}-lib.log
SetEnv RadeonGLDump 400
SetEnv RadeonGLDumpFile DEV:Test/nullx-{demo}-f400.r2d
Assign LIBS: DEV:Libs/RadeonGL ADD
GLQuake -anycpu {extra} -stdout -nosound -nocdaudio -noudp -nolan -timedemoquit +timedemo {demo} >DEV:Test/nullx-{demo}.log
Echo "nullx {demo} rc=$RC" >>DEV:Test/nullx-{demo}.log
Assign LIBS: DEV:Libs/RadeonGL REMOVE
UnSetEnv RadeonGLLog
UnSetEnv RadeonGLDump
UnSetEnv RadeonGLDumpFile
Echo >DEV:Test/nullx-{demo}.done done
