# smakefile -- native AmigaOS build with SAS/C's smake.
#
# Generated into DEV:src/ (dist/src on the host) by the host-side
# "gmake all", together with a mirror of all project sources, so the
# project can be compiled and debugged directly on the Amiga:
#
#   smake          incremental build             -> @PROJECT_NAME@
#   smake debug    full rebuild with source-level -> @PROJECT_NAME@.debug
#                  debug info for CodeProbe:  cpr @PROJECT_NAME@.debug
#   smake kdebug   serial-debug build (LMDEBUG,  -> @PROJECT_NAME@.kdbg
#                  kprintf via debug.lib): read the DBG() trace over the
#                  serial port. Same as the host "gmake debug".
#   smake clean    remove objects and binaries
#
# Unlike the host-side vamos build, no IDIR= is forced here: a native
# SAS/C installation supplies its own include/library configuration.
# main.c (the GCC entry point) is mirrored alongside but not built here.
#
# NOTE: the mirror is one-way (host -> DEV:). Edits made to these files
# on the Amiga side are overwritten by the next host-side build.

OBJS = main_sasc.o
SRCS = main_sasc.c

# NOSTACKCHECK: SAS/C's per-function stack check is unsafe inside OS callbacks
# such as BOOPSI/ReAction class dispatchers (it corrupts the task stack). Turn
# it off and size the stack with a "$STACK: <bytes>" cookie instead (see
# README). Harmless for plain CLI tools.
SCOPTS = NOSTACKCHECK

all: @PROJECT_NAME@

@PROJECT_NAME@: $(OBJS)
	slink FROM lib:c.o $(OBJS) TO @PROJECT_NAME@ LIB lib:sc.lib lib:amiga.lib

debug:
	sc LINK DEBUG=SF $(SCOPTS) TO @PROJECT_NAME@.debug $(SRCS)

# Serial-debug (kprintf) build: DEFINE LMDEBUG turns on the DBG() trace,
# DEFINE DBG_TAG names the trace lines, and lib:debug.lib supplies KPrintF().
# Output goes to the serial port.
kdebug:
	sc LINK $(SCOPTS) DEFINE LMDEBUG DEFINE DBG_TAG=@PROJECT_NAME@ TO @PROJECT_NAME@.kdbg $(SRCS) lib:debug.lib

clean:
	delete $(OBJS) @PROJECT_NAME@ @PROJECT_NAME@.debug @PROJECT_NAME@.kdbg

.c.o:
	sc $(SCOPTS) NOLINK $*.c
