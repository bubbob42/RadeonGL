# Build artifacts
build/
dist/

# Version includes: bumprev refreshes these only on "gmake release". The .rev
# counter and the _rev.h header are committed (the header is compiled into the
# binary, so it must be present on a fresh checkout). The _rev.i asm include is
# a generated build product that nothing here uses, so it stays ignored.
src/*_rev.i

# Generated vamos config
.vamosrc

# Local SMB push target (written by ./setup-smb.sh; personal to this checkout)
smbpush.conf

# macOS
.DS_Store

# VS Code local/user state
.vscode/*.log
*.code-workspace

# Backups
*.bak
*.bak.*
*.old
*.tmp

# fs-uae
fsuae/local/
*.hdf
*.rom
*.adf

# Reference material (pulled by new_project.sh; not committed -- the canonical
# copies live under ~/Developer/Reference and the RKRM cache)
reference/*.pdf
reference/*.md
# the Picasso96's private reference documents: private, never committed
reference/*.doc

# Quake game data -- id Software copyright, never committed (use QUAKE_ID1=, see glquake/README.md)
*.pak
*.PAK
