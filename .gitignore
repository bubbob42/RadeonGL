# Build artifacts
build/
dist/

# Version includes: bumprev refreshes these only on "gmake release". The .rev
# counter and the _rev.h header are committed (the header is compiled into the
# binary, so it must be present on a fresh checkout). The _rev.i asm include is
# a generated build product that nothing here uses, so it stays ignored.
src/*_rev.i

# Generated vamos config
.vamosrc

# Local SMB push target (written by ./setup-smb.sh; personal to this checkout)
smbpush.conf

# macOS
.DS_Store

# VS Code local/user state
.vscode/*.log
*.code-workspace

# Backups
*.bak
*.bak.*
*.old
*.tmp

# fs-uae
fsuae/local/
*.hdf
*.rom
*.adf

# Reference material (pulled by new_project.sh; not committed -- the canonical
# copies live under ~/Developer/Reference and the RKRM cache)
reference/*.pdf
reference/*.md
# the Picasso96's private reference documents: private, never committed
reference/*.doc

# Quake game data -- id Software copyright, never committed (use QUAKE_ID1=, see
# ../RadeonGL-GLQuake/README.md)
*.pak
*.PAK

# GLQuake, the test client, is not part of this repository: its source lives
# beside it (GLQUAKE_DIR, default ../RadeonGL-GLQuake)
/glquake/

# Thomas Richter's openpci kit: it may travel only as his whole archive
# (Aminet driver/other/openpci68k.lha); fetched locally, never committed
/sdk/openpci/

# Not part of the published repository (the user, 2026-11-03): design notes
# and research, editor and assistant settings, and the starter template's
# leftovers. They stay in the local checkout.
/docs/
/.claude/
/.vscode/
/CLAUDE.md
/new_project.sh
/setup-smb.sh
/catalogs/
# AHI and CyberGraphX headers: only GLQuake used them (../RadeonGL-GLQuake)
/sdk/ahi/
/sdk/cgx/
