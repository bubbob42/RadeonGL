PROJECT_NAME := $(notdir $(CURDIR))
# the release archive's Source drawer: its folder is not the project's
# name, the revision file is (src/<name>_rev.rev)
ifeq ($(wildcard src/$(PROJECT_NAME)_rev.rev),)
PROJECT_NAME := $(patsubst src/%_rev.rev,%,$(firstword $(wildcard src/*_rev.rev)))
endif

# Local SMB target for `gmake push`, written by ./setup-smb.sh (git-ignored,
# personal to this checkout). Optional: absent until you run the setup script.
# Command-line SMB_* overrides still win. See the `push` target at the bottom.
-include smbpush.conf

FSUAE ?= /opt/homebrew/bin/fs-uae

FSUAE_TEMPLATE := fsuae/project.fs-uae.in
FSUAE_CONFIG   := fsuae/local/$(PROJECT_NAME).fs-uae

KICKSTART_FILE ?= $(HOME)/Developer/AmigaEmu/ROMs/kick32.rom
SYSTEM_HDF     ?= $(HOME)/Developer/AmigaEmu/HDF/AmigaOS32.hdf
PROJECT_DIST   := $(CURDIR)/dist

# OPTIONAL Kickstart 1.3 / plain-68000 test machine (gmake run-fsuae13): its own
# ROM, hardfile and FS-UAE template, separate from the 3.x machine above, for
# checking that a program really runs on 1.3. Entirely optional -- `gmake check`
# reports these paths but never fails on them, and nothing in `all` needs them.
KICKSTART13_FILE ?= $(HOME)/Developer/AmigaEmu/ROMs/kick13.rom
SYSTEM13_HDF     ?= $(HOME)/Developer/AmigaEmu/HDF/AmigaOS13.hdf
FSUAE_TEMPLATE13 := fsuae/project13.fs-uae.in
FSUAE_CONFIG13   := fsuae/local/$(PROJECT_NAME)-13.fs-uae

PREFIX ?= $(HOME)/amiga-arm

GCC_CC      := $(PREFIX)/bin/m68k-amigaos-gcc
GCC_STRIP   := $(PREFIX)/bin/m68k-amigaos-strip
GCC_OBJDUMP := $(PREFIX)/bin/m68k-amigaos-objdump

VAMOS   ?= $(HOME)/Developer/AmigaTools/venv-amitools/bin/vamos
VAMOSRC := .vamosrc

# -m 16128: vamos's default RAM size is too small to compile larger source
# files with sc (observed as a vamos-internal "NO MEMORY" error while sc
# loads its own support libraries, not a problem with the source itself).
# -H disable is required alongside the larger RAM size -- vamos refuses
# "too much RAM allocated with hw access enabled" otherwise. Give both the
# compile and link steps the same generous allowance.
# Host python, for the tools/ helpers (tools/check_installer.py below).
PYTHON      ?= python3

VAMOS_SC    := $(VAMOS) -c $(VAMOSRC) -q -H disable -m 16128
VAMOS_SLINK := $(VAMOS) -c $(VAMOSRC) -q -H disable -m 16128

# NOSTACKCHECK: SAS/C inserts a per-function stack-overflow check that calls
# an overflow handler (__XCOVF) when it thinks the stack is low. That handler
# is unsafe when the function is a callback invoked by the OS -- most notably
# a BOOPSI/ReAction class dispatcher called by Intuition -- where it corrupts
# the task's user stack (seen as an exec address-error crash). Programs that
# install such callbacks should turn the check off and instead guarantee an
# adequate stack with a "$STACK: <bytes>" cookie (see README). Harmless for
# plain CLI tools. Applied to every sc compile below.
#
# PARAMETERS=REGISTERS: pass function arguments in registers instead of on the
# stack -- the natural 680x0 convention. Fewer pushes at every call site, less
# stack traffic ("stack ping-pong"), and shallower call depth. SAS/C's own
# manual recommends it for fully-prototyped programs (which these are, by house
# style). GCC's matching flag is -msasregparm below: the SAME convention (ints
# in d0/d1, pointers in a0/a1), so both profiles share one calling ABI.
#
# Safe because every cross-module boundary already pins its own convention:
# OS API calls are register-pinned by the proto/inline headers; C-runtime calls
# keep their own convention (sc.lib accepts both; the gcc headers mark libc
# __stdargs); BOOPSI/hook dispatchers pin registers with __saveds __asm /
# __asm("aN"). Only calls between our own functions change, and those are
# uniform within each binary. In SC_OPTS (not the release-only optimiser flags)
# so it applies to ALL builds -- the debug ABI then matches what ships.
SC_OPTS := NOSTACKCHECK PARAMETERS=REGISTERS

SASC_PATH ?= $(HOME)/Developer/AmigaSDK/SASC/SC

# bumprev: advances the revision and regenerates the version includes
# (src/$(PROJECT_NAME)_rev.h and _rev.i, backed by the committed counter
# _rev.rev). An AmigaOS tool, run through vamos. Version is held at 0; only the
# revision advances. Bumping happens ONLY in the "release" target -- ordinary
# builds compile against the committed _rev.h and do not touch it. The $VER
# cookie in src/main*.c reads VERSTAG from that header.
BUMPREV ?= $(HOME)/Developer/AmigaTools/bumprev/bumprev
REV_VERSION := 0

# Committed version include (generated by bumprev, refreshed only on "release").
# A prerequisite of the compile targets so a release bump forces a rebuild.
REV_H := src/$(PROJECT_NAME)_rev.h

# --- Optional staging (all skip cleanly when their source dir is absent) -----
# These let a derived project ship the usual AmigaOS extras just by dropping the
# sources into place; the pristine starter has none of them, so `gmake all`
# stages nothing and stays quiet. See docs/ for each area.
#
#   icons/$(PROJECT_NAME).info            -> dist-icons (Workbench program icon)
#   guide/<lang>/$(PROJECT_NAME).guide    -> guides     (AmigaGuide online help)
#   install/Install(.info)                -> installer  (Installer script + icon)
#   rexx/*.rexx                           -> rexx-examples (ARexx macros)
#   catalogs/$(PROJECT_NAME).cd + <lang>/ -> catalogs   (locale message catalogs)
GUIDE_DEFAULT_LANG ?= english
GUIDE_LANGS        ?= english deutsch
LOCALE_LANGS       ?=
LOCALE_CATNAME     := $(PROJECT_NAME).catalog
LOCALE_CD          := catalogs/$(PROJECT_NAME).cd

# Optional publish target (gmake push): mirror the built dist/ onto an SMB
# (Samba) share. macOS only. Configure the share once with ./setup-smb.sh (it
# writes the git-ignored smbpush.conf included at the top); or override on the
# command line, e.g. `gmake push SMB_HOST=nas SMB_SHARE=amiga`. No host/share
# default is baked in -- the share is yours to supply.
SMB_DIR  ?= $(PROJECT_NAME)

TARGET_GCC  := dist/$(PROJECT_NAME)_gcc
TARGET_SASC := dist/$(PROJECT_NAME)_sasc

SRC_GCC  := src/main.c
SRC_SASC := src/main_sasc.c
OBJ_SASC := build/main_sasc.o

# 68000 is the project baseline and what every ordinary target builds. The
# OPTIONAL per-CPU variant targets at the bottom re-enter make with CPU=<n>
# set; nothing else does, so the default is unchanged. An explicit
# CPUFLAGS=... on the command line still wins over both.
CPU      ?=
CPUFLAGS ?= -m$(if $(CPU),$(CPU),68000)

# -Wno-int-conversion: like -Wno-pointer-sign, this silences a false positive
# from the classic NDK inlines rather than a real bug. The AmigaOS varargs
# stubs (Printf/VPrintf/EasyRequest ...) declare their argument as a scalar, so
# passing a pointer (e.g. a "%s" string) trips -Wint-conversion on every call.
# Suppress it at the build level instead of casting every vararg in source.
GCC_WARNINGS := -Wall -Wextra -Wno-pointer-sign -Wno-int-conversion -Werror=implicit-function-declaration
# -msasregparm: register-based parameter passing, the SAS/C-compatible variant
# (integer args in d0/d1, pointers in a0/a1, the rest on the stack) -- the same
# calling convention as the SAS/C profile's PARAMETERS=REGISTERS (see SC_OPTS).
# The 680x0 register convention: fewer arg pushes at each call site and less
# stack traffic. Only calls between our own functions are affected -- OS calls
# stay register-pinned via the inline headers and libc calls stay stack-pinned
# via their __stdargs declarations. In GCC_CFLAGS (shared by the release and
# debug rules) so it applies to ALL builds, matching the SAS/C side.
GCC_CFLAGS   := $(GCC_WARNINGS) -Os -std=gnu99 -msasregparm $(CPUFLAGS)
GCC_LDFLAGS  := -noixemul -lamiga

.PHONY: all gcc sasc debug release run-sasc fsuae-config launch-fsuae run-fsuae run-fsuae-gcc run-fsuae-sasc fsuae-config13 launch-fsuae13 run-fsuae13 info check clean distclean mirror-src dist-icons guides installer rexx-examples catalogs catalog-check push wb-run release-stage release-drawer release-archive release-lha release-aminet release-verify release-dist

all: gcc sasc debug dist/runme dist/mutools mirror-src dist-icons guides installer rexx-examples catalogs catalog-check wb-run probes census-lib r200-objs rgl-lib

# release: advance the revision, then rebuild both profiles so the new $VER is
# embedded. This is the ONLY target that bumps -- run it by hand when cutting a
# release, never automatically. bumprev runs first (from src/, so the generated
# _rev.h lands beside the sources) and rewrites $(REV_H); the recursive make
# then sees the fresher header and recompiles.
release:
	cd src && $(VAMOS) -q $(BUMPREV) $(REV_VERSION) $(PROJECT_NAME)
	$(MAKE) all

gcc: $(TARGET_GCC)

$(TARGET_GCC): $(REV_H) $(SRC_GCC)
	mkdir -p dist
	$(GCC_CC) $(GCC_CFLAGS) $(SRC_GCC) -o $(TARGET_GCC) $(GCC_LDFLAGS)

sasc: $(TARGET_SASC)

# -H disable -m 16128: works around a vamos/slink interaction where slink
# transiently dereferences an out-of-bounds pointer while resolving a large
# amiga.lib symbol set. Real hardware tolerates this silently; vamos's default
# strict memory map does not. See the VAMOS_SC/VAMOS_SLINK definitions above
# for why both the compile and link steps need this.
$(TARGET_SASC): $(REV_H) $(SRC_SASC) $(VAMOSRC)
	mkdir -p build dist
	$(VAMOS_SC) sc $(SC_OPTS) NOLINK IDIR=include: IDIR=proj:src/ OBJNAME=proj:$(OBJ_SASC) proj:$(SRC_SASC)
	$(VAMOS_SLINK) slink FROM lib:c.o proj:$(OBJ_SASC) TO proj:$(TARGET_SASC) LIB lib:sc.lib lib:amiga.lib

# --- Debug builds ---------------------------------------------------------
# Same sources compiled with -DLMDEBUG, which turns on the DBG() serial trace
# (src/debug.h) and links debug.lib for KPrintF(). -DDBG_TAG=$(PROJECT_NAME)
# makes each project's trace lines self-identify ("<project>: ..."). Separate
# outputs and object dir keep the release builds untouched. Read the trace over
# FS-UAE's tcp serial: `telnet 127.0.0.1 1234` (same channel as DEV:mutools).
TARGET_GCC_DEBUG  := dist/$(PROJECT_NAME)_gcc_debug
TARGET_SASC_DEBUG := dist/$(PROJECT_NAME)_sasc_debug

debug: $(TARGET_GCC_DEBUG) $(TARGET_SASC_DEBUG)

$(TARGET_GCC_DEBUG): $(REV_H) $(SRC_GCC) src/debug.h
	mkdir -p dist
	$(GCC_CC) $(GCC_CFLAGS) -DLMDEBUG -DDBG_TAG=$(PROJECT_NAME) $(SRC_GCC) -o $(TARGET_GCC_DEBUG) $(GCC_LDFLAGS) -ldebug

$(TARGET_SASC_DEBUG): $(REV_H) $(SRC_SASC) src/debug.h $(VAMOSRC)
	mkdir -p build/debug dist
	$(VAMOS_SC) sc $(SC_OPTS) DEFINE LMDEBUG DEFINE DBG_TAG=$(PROJECT_NAME) NOLINK IDIR=include: IDIR=proj:src/ OBJNAME=proj:build/debug/main_sasc.o proj:$(SRC_SASC)
	$(VAMOS_SLINK) slink FROM lib:c.o proj:build/debug/main_sasc.o TO proj:$(TARGET_SASC_DEBUG) LIB lib:sc.lib lib:amiga.lib lib:debug.lib

# --- Workbench desktop run scripts -------------------------------------------
# Three IconX scripts staged on DEV: with icons and a .backdrop file. A
# .backdrop file in a volume's ROOT lists icons (one path per line, relative to
# the root) that Workbench shows directly on the desktop -- so when DEV:
# mounts, the icons sit on the Workbench ready to double-click:
#   Run      -- runs the release (GCC) build.
#   RunDebug -- starts MuForce/MuGuardianAngel (DEV:mutools), then runs the
#               kprintf debug build; trace via `telnet 127.0.0.1 1234`.
#   MuTools  -- starts MuForce/MuGuardianAngel and nothing else, so ANY other
#               icon can then be run guarded.
# The icons (icons/run*.info, icons/mutools.info -- regenerate with
# tools/make_run_icons.py) carry C:IconX as default tool and a WINDOW tooltype
# so output stays visible.
#
# ⚠ EVERY script starts with `Assign >NIL: DEV: ""`. IconX makes the icon's own
# drawer the current directory, so this makes DEV: mean "wherever this script
# lives" -- and a dist/ drawer simply COPIED onto real hardware then resolves
# its DEV: paths unchanged, with no assign to set up by hand. Under FS-UAE it
# reassigns DEV: to the place it already is, so nothing changes there.
#
# Whenever the user is asked to test something in the emulator or on hardware,
# stage it this way: binaries, volumes and arguments baked in, so they
# double-click an icon instead of typing paths into the emulated Shell. Name a
# script after what it proves and keep the icon name stable as its contents
# change. A test script must also INSTALL what it tests -- one that only opens
# something exercises whatever build is already resident and reports the old
# behaviour, convincingly.
#
# NOTE: this rule must stay below the TARGET_GCC_DEBUG definition --
# prerequisites expand when the rule is read.
WB_ASSIGN_DEV := Assign >NIL: DEV: ""

wb-run: $(TARGET_GCC) $(TARGET_GCC_DEBUG) dist/mutools
	@mkdir -p dist
	@printf '%s\n' '$(WB_ASSIGN_DEV)' > dist/Run
	@printf 'echo "Running $(PROJECT_NAME)..."\n' >> dist/Run
	@printf 'DEV:%s\n' "$(notdir $(TARGET_GCC))" >> dist/Run
	@printf 'echo "Done."\n' >> dist/Run
	@printf '%s\n' '$(WB_ASSIGN_DEV)' > dist/RunDebug
	@printf 'echo "Starting MuForce/MuGuardianAngel (trace: telnet 127.0.0.1 1234)..."\n' >> dist/RunDebug
	@printf 'execute DEV:mutools\n' >> dist/RunDebug
	@printf 'echo "Running the kprintf debug build..."\n' >> dist/RunDebug
	@printf 'DEV:%s\n' "$(notdir $(TARGET_GCC_DEBUG))" >> dist/RunDebug
	@printf 'echo "Done. The serial trace is on telnet 127.0.0.1:1234."\n' >> dist/RunDebug
	@# NO "dist/MuTools" wrapper script! The host filesystem is
	@# case-INsensitive, so dist/MuTools and dist/mutools are THE SAME
	@# FILE: such a wrapper ("execute DEV:mutools") overwrites the
	@# payload, which then executes ITSELF forever -- an Execute
	@# recursion that eats the Amiga's RAM (looks like a massive leak)
	@# and never starts MuForce. AmigaDOS is case-insensitive too, so
	@# mutools.info doubles as the desktop icon FOR the payload itself.
	@cp fsuae/mutools dist/mutools
	@if [ -f icons/run.info ]; then cp icons/run.info dist/Run.info; fi
	@if [ -f icons/rundebug.info ]; then cp icons/rundebug.info dist/RunDebug.info; fi
	@if [ -f icons/mutools.info ]; then cp icons/mutools.info dist/mutools.info; fi
	@printf 'Run\nRunDebug\nmutools\n' > dist/.backdrop
	@echo "wb-run: staged Run + RunDebug + mutools icons (+ .backdrop) on DEV:"

$(VAMOSRC): .vamosrc.in
	sed \
		-e 's|@SASC_PATH@|$(SASC_PATH)|g' \
		-e 's|@PROJECT_PATH@|$(CURDIR)|g' \
		.vamosrc.in > $(VAMOSRC)

# The HELP: assign makes any staged AmigaGuide help (dist/Help/, from `guides`)
# reachable as HELP: without disturbing the system assigns (ADD appends; >NIL:
# swallows the harmless error when nothing was staged). A self-contained app
# also finds its guide in PROGDIR: (= DEV:) regardless.
dist/run-gcc: $(TARGET_GCC)
	mkdir -p dist
	printf 'Assign >NIL: HELP: DEV:Help ADD\n' > dist/run-gcc
	printf 'DEV:%s\n' "$(notdir $(TARGET_GCC))" >> dist/run-gcc

dist/run-sasc: $(TARGET_SASC)
	mkdir -p dist
	printf 'Assign >NIL: HELP: DEV:Help ADD\n' > dist/run-sasc
	printf 'DEV:%s\n' "$(notdir $(TARGET_SASC))" >> dist/run-sasc

dist/runme: dist/run-gcc dist/run-sasc
	mkdir -p dist
	printf 'echo "Available binaries on DEV:"\n' > dist/runme
	printf 'list DEV:\n' >> dist/runme
	printf 'echo ""\n' >> dist/runme
	printf 'echo "Run GCC build:"\n' >> dist/runme
	printf 'echo "  DEV:%s"\n' "$(notdir $(TARGET_GCC))" >> dist/runme
	printf 'echo "Run SAS/C build:"\n' >> dist/runme
	printf 'echo "  DEV:%s"\n' "$(notdir $(TARGET_SASC))" >> dist/runme
	printf 'echo ""\n' >> dist/runme
	printf 'echo "Or execute helper scripts:"\n' >> dist/runme
	printf 'echo "  execute DEV:run-gcc"\n' >> dist/runme
	printf 'echo "  execute DEV:run-sasc"\n' >> dist/runme

# MuForce/MuGuardianAngel debug-session starter (run via "execute DEV:mutools"
# inside AmigaOS). Static file, copied verbatim -- not templated.
dist/mutools: fsuae/mutools
	mkdir -p dist
	cp fsuae/mutools dist/mutools

# Mirror all sources into dist/src (DEV:src inside AmigaOS), along with
# an smakefile (SAS/C smake) and a Makefile (Amiga make ports) generated
# from the .in templates in src/, so the project can also be compiled
# and debugged natively on the Amiga. The mirror is one-way: host wins.
MIRROR_SRC := $(wildcard src/*.c) $(wildcard src/*.h)

mirror-src:
	mkdir -p dist/src
	cp $(MIRROR_SRC) dist/src/
	sed -e 's|@PROJECT_NAME@|$(PROJECT_NAME)|g' src/smakefile.in > dist/src/smakefile
	sed -e 's|@PROJECT_NAME@|$(PROJECT_NAME)|g' src/Makefile.in > dist/src/Makefile

# --- Optional staging targets ------------------------------------------------
# Each is folded into `all` but does nothing until the project provides its
# source files, so the pristine starter builds clean and a derived project just
# drops the sources in place. None of them fail when their inputs are absent.

# Workbench program icons: a committed icons/$(PROJECT_NAME).info (author it with
# tools/amiga_icon.py) is copied beside each binary so it shows on DEV:.
dist-icons:
	@if [ -f icons/$(PROJECT_NAME).info ]; then \
		mkdir -p dist; \
		cp icons/$(PROJECT_NAME).info $(TARGET_GCC).info; \
		cp icons/$(PROJECT_NAME).info $(TARGET_SASC).info; \
		echo "icons: staged Workbench program icons"; \
	fi

# AmigaGuide online help. Committed sources live in guide/<lang>/. The default
# language is staged both flat (PROGDIR:$(PROJECT_NAME).guide, found next to the
# program) and under HELP:; each additional GUIDE_LANGS language goes to
# HELP:<lang>/. The run scripts Assign HELP: to DEV:Help so FS-UAE finds them.
guides:
	@if [ -f guide/$(GUIDE_DEFAULT_LANG)/$(PROJECT_NAME).guide ]; then \
		mkdir -p dist dist/Help; \
		iconv -f UTF-8 -t ISO-8859-1 guide/$(GUIDE_DEFAULT_LANG)/$(PROJECT_NAME).guide > dist/$(PROJECT_NAME).guide; \
		cp dist/$(PROJECT_NAME).guide dist/Help/$(PROJECT_NAME).guide; \
		if [ -f icons/guide.info ]; then \
			cp icons/guide.info dist/$(PROJECT_NAME).guide.info; \
		fi; \
		echo "guides: staged PROGDIR: + HELP:$(PROJECT_NAME).guide ($(GUIDE_DEFAULT_LANG))"; \
		for lang in $(GUIDE_LANGS); do \
			if [ -f guide/$$lang/$(PROJECT_NAME).guide ]; then \
				mkdir -p dist/Help/$$lang; \
				iconv -f UTF-8 -t ISO-8859-1 guide/$$lang/$(PROJECT_NAME).guide > dist/Help/$$lang/$(PROJECT_NAME).guide; \
				if [ -f icons/guide.info ]; then \
					cp icons/guide.info dist/Help/$$lang/$(PROJECT_NAME).guide.info; \
				fi; \
				echo "guides: staged HELP:$$lang/$(PROJECT_NAME).guide"; \
			fi; \
		done; \
	fi

# Installer: stage install/Install (project name substituted) + its Workbench
# icon into dist/, so on the Amiga the user double-clicks the Install icon.
# Regenerate the icon with tools/make_install_icon.py.
installer:
	@# Lint before staging. The trap it guards -- a multi-line message wrapped
	@# in the substitution form, where every line after the first silently
	@# becomes an ARGUMENT to the first -- still parses and still shows a page,
	@# so nothing downstream notices. It was in THIS template's own version
	@# check, and every project generated from here inherited it.
	@#
	@# The shipped copy also carries NO comments. They are engineering notes
	@# and belong in the file that is maintained, not in the one a user opens
	@# out of curiosity.
	@#
	@# Stripped by the linter, NEVER by sed: ';' only starts a comment OUTSIDE
	@# a string, so 's/;.*//' cuts any prompt containing one in half -- and
	@# silently, because the result still parses.
	@if [ -f install/Install ]; then $(PYTHON) tools/check_installer.py install/Install; fi
	@if [ -f install/Install ]; then \
		mkdir -p dist; \
		$(PYTHON) tools/check_installer.py --strip install/Install > dist/.Install.tmp; \
		sed -e 's|@PROJECT_NAME@|$(PROJECT_NAME)|g' dist/.Install.tmp > dist/Install; \
		rm -f dist/.Install.tmp; \
		if [ -f install/Install.info ]; then cp install/Install.info dist/Install.info; fi; \
		echo "installer: staged DEV:Install"; \
	fi

# Example ARexx macros (rexx/*.rexx) staged to DEV:Rexx/ so a command port can
# be exercised in FS-UAE (e.g. "rx DEV:Rexx/Demo.rexx" while the app runs).
rexx-examples:
	@if ls rexx/*.rexx >/dev/null 2>&1; then \
		mkdir -p dist/Rexx; \
		cp -f rexx/*.rexx dist/Rexx/; \
		echo "rexx: staged DEV:Rexx/"; \
	fi

# --- Localization: message catalogs -----------------------------------------
# Sources (host, UTF-8): catalogs/$(PROJECT_NAME).cd (the string descriptor;
# generate it from your app_strings.h with tools/gen_catalog.py) and one
# catalogs/<lang>/$(PROJECT_NAME).ct per language in LOCALE_LANGS.
#
# The .catalog files are built HERE, on the host, by tools/make_catalog.py --
# so a translation change reaches the package in the same build that changed
# it. That used to need FS-UAE (the Amiga's CatComp wants iffparse.library,
# which vamos cannot provide), and the round trip was silent when skipped: a
# WORDING change does not move the catalog version fingerprint, so a stale
# .catalog still loads, still passes every guard, and simply shows the previous
# translation. One project in this family went further and shipped a whole
# release in English that way, with nothing in the build to say so.
#
# The generator is byte-compatible with the Amiga tool -- verified by
# reproducing catalogs CatComp built, exactly, from the same descriptor and
# translation (tools/make_catalog.py --compare). The .cd/.ct sources and the
# DEV:gencat script are still staged, so the on-Amiga route stays available as
# a cross-check.
catalogs:
	@if [ -f $(LOCALE_CD) ]; then \
		mkdir -p dist/Catalogs; \
		iconv -f UTF-8 -t ISO-8859-1 $(LOCALE_CD) > dist/Catalogs/$(PROJECT_NAME).cd; \
		for lang in $(LOCALE_LANGS); do \
			mkdir -p dist/Catalogs/$$lang; \
			iconv -f UTF-8 -t ISO-8859-1 catalogs/$$lang/$(PROJECT_NAME).ct \
				> dist/Catalogs/$$lang/$(PROJECT_NAME).ct; \
			$(PYTHON) tools/make_catalog.py $(LOCALE_CD) \
				catalogs/$$lang/$(PROJECT_NAME).ct \
				dist/Catalogs/$$lang/$(LOCALE_CATNAME) || exit 1; \
		done; \
		printf '; gencat -- build %s message catalogs (run inside AmigaOS)\n' "$(PROJECT_NAME)" > dist/gencat; \
		printf 'echo "Building message catalogs..."\n' >> dist/gencat; \
		for lang in $(LOCALE_LANGS); do \
			printf 'c:catcomp DEV:Catalogs/%s.cd DEV:Catalogs/%s/%s.ct CATALOG DEV:Catalogs/%s/%s\n' \
				"$(PROJECT_NAME)" "$$lang" "$(PROJECT_NAME)" "$$lang" "$(LOCALE_CATNAME)" >> dist/gencat; \
			printf 'echo "  %s/%s"\n' "$$lang" "$(LOCALE_CATNAME)" >> dist/gencat; \
		done; \
		printf 'echo "Done."\n' >> dist/gencat; \
		if [ -n "$(strip $(LOCALE_LANGS))" ]; then \
			echo "catalogs: built + staged for: $(LOCALE_LANGS) (sources + DEV:gencat too)"; \
		else \
			echo "catalogs: descriptor staged; no language yet --"; \
			echo "          tools/gen_catalog.py newlang <language>, then add it to LOCALE_LANGS"; \
		fi; \
	else \
		echo "catalogs: $(LOCALE_CD) not found -- nothing to stage"; \
	fi

# catalog-check: warn when a built .catalog does not match the binary that will
# ask for it (a stale catalog maps ids to the WRONG strings -- and a shifted
# format string feeds wrong arguments into RawDoFmt, seen as a MuForce hit storm
# on real hardware). Quiet when nothing is built yet or LOCALE_LANGS is empty;
# never fatal. Folded into `all`.
#
# ⚠ NOT a timestamp comparison. This dates from when CatComp ran inside FS-UAE,
# which stamps the file with the EMULATED clock -- so a freshly built catalog
# read as older than its sources and the warning fired after every correct
# rebuild. A check that cries wolf is one you learn to scroll past, and then it
# misses the real case. The host builder makes the dates honest again, but the
# signature is still the better test: it compares what actually decides at run
# time, and it keeps working for a catalog built the on-Amiga way.
#
# What is compared instead is the thing that actually decides at run time:
# gen_catalog.py stamps an id-layout fingerprint into src/app_catver.h as
# <PREFIX>_CATALOG_SIG ("<PREFIX>CAT-<n>") and into every .catalog as its id-0
# string, and OpenCatalog matches the version EXACTLY. So if the built catalog
# contains that literal signature it is current, whatever its date says. Reading
# the signature out of the header keeps this project-agnostic -- no prefix and
# no version number is hardcoded here.
CATVER_H := src/app_catver.h

catalog-check:
	@sig=""; \
	if [ -f "$(CATVER_H)" ]; then \
		sig=`sed -n 's/^#define [A-Z0-9_]*_CATALOG_SIG[ 	]*"\(.*\)"/\1/p' \
		     "$(CATVER_H)" | head -1`; \
	fi; \
	for lang in $(LOCALE_LANGS); do \
		built="dist/Catalogs/$$lang/$(LOCALE_CATNAME)"; \
		if [ -f "$$built" ] && [ -n "$$sig" ]; then \
			if ! LC_ALL=C grep -a -q -F "$$sig" "$$built"; then \
				have=`LC_ALL=C grep -a -o -E '[A-Z0-9]+CAT-[0-9]+' "$$built" \
				      | head -1`; \
				echo "WARNING: $$built is STALE -- rebuild it:"; \
				echo "  the binary asks for '$$sig', the catalog carries '$${have:-none}'"; \
				echo "  run 'gmake catalogs' (regenerate the .cd with"; \
				echo "   tools/gen_catalog.py first if you edited src/app_strings.h)"; \
			fi; \
		fi; \
	done


run-sasc: $(TARGET_SASC)
	$(VAMOS) -c $(VAMOSRC) -q proj:$(TARGET_SASC)

fsuae-config: $(FSUAE_CONFIG)

$(FSUAE_CONFIG): $(FSUAE_TEMPLATE)
	mkdir -p fsuae/local
	sed \
		-e 's|@KICKSTART_FILE@|$(KICKSTART_FILE)|g' \
		-e 's|@SYSTEM_HDF@|$(SYSTEM_HDF)|g' \
		-e 's|@PROJECT_DIST@|$(PROJECT_DIST)|g' \
		-e 's|@PROJECT_NAME@|$(PROJECT_NAME)|g' \
		$(FSUAE_TEMPLATE) > $(FSUAE_CONFIG)

launch-fsuae: $(FSUAE_CONFIG)
	@echo "Starting FS-UAE with config: $(abspath $(FSUAE_CONFIG))"
	@echo "FS-UAE binary: $(FSUAE)"
	@test -f "$(FSUAE_CONFIG)" || (echo "Missing FS-UAE config: $(FSUAE_CONFIG)" && exit 1)
	@CFG="$(abspath $(FSUAE_CONFIG))"; \
	"$(FSUAE)" "$$CFG" & \
	FSUAE_PID=$$!; \
	sleep 1; \
	osascript -e 'tell application "System Events" to set frontmost of the first process whose unix id is '"$$FSUAE_PID"' to true' || true

run-fsuae: all fsuae-config launch-fsuae

# --- OPTIONAL Kickstart 1.3 / 68000 machine (same shape, different box) ------
# gmake run-fsuae13 -- build, generate the 1.3 config, launch it.
#
# Needs a 1.3 ROM and a 1.3 system hardfile (KICKSTART13_FILE / SYSTEM13_HDF).
# Nothing else in the build depends on it, so a machine without those files is
# in no way broken -- `gmake check` reports them and moves on.
fsuae-config13: $(FSUAE_CONFIG13)

$(FSUAE_CONFIG13): $(FSUAE_TEMPLATE13)
	mkdir -p fsuae/local
	sed \
		-e 's|@KICKSTART_FILE@|$(KICKSTART13_FILE)|g' \
		-e 's|@SYSTEM_HDF@|$(SYSTEM13_HDF)|g' \
		-e 's|@PROJECT_DIST@|$(PROJECT_DIST)|g' \
		-e 's|@PROJECT_NAME@|$(PROJECT_NAME)|g' \
		$(FSUAE_TEMPLATE13) > $(FSUAE_CONFIG13)

launch-fsuae13: $(FSUAE_CONFIG13)
	@test -f "$(KICKSTART13_FILE)" || (echo "Missing Kickstart 1.3 ROM: $(KICKSTART13_FILE)" && \
		echo "  (set KICKSTART13_FILE=... or skip the 1.3 machine)" && exit 1)
	@test -f "$(SYSTEM13_HDF)" || (echo "Missing AmigaOS 1.3 HDF: $(SYSTEM13_HDF)" && \
		echo "  (set SYSTEM13_HDF=... or skip the 1.3 machine)" && exit 1)
	@echo "Starting FS-UAE (Kickstart 1.3 / 68000) with config: $(abspath $(FSUAE_CONFIG13))"
	@echo "FS-UAE binary: $(FSUAE)"
	@CFG="$(abspath $(FSUAE_CONFIG13))"; \
	"$(FSUAE)" "$$CFG" & \
	FSUAE_PID=$$!; \
	sleep 1; \
	osascript -e 'tell application "System Events" to set frontmost of the first process whose unix id is '"$$FSUAE_PID"' to true' || true

run-fsuae13: all fsuae-config13 launch-fsuae13

run-fsuae-gcc: gcc dist/run-gcc dist/mutools mirror-src fsuae-config launch-fsuae

run-fsuae-sasc: sasc dist/run-sasc dist/mutools mirror-src fsuae-config launch-fsuae

info: all
	file $(TARGET_GCC)
	file $(TARGET_SASC)
	$(GCC_OBJDUMP) -f $(TARGET_GCC)

check:
	@echo "Project:        $(CURDIR)"
	@echo "PROJECT_NAME:   $(PROJECT_NAME)"
	@echo "GCC:            $(GCC_CC)"
	@echo "VAMOS:          $(VAMOS)"
	@echo "SASC_PATH:      $(SASC_PATH)"
	@echo "FSUAE:          $(FSUAE)"
	@echo "FSUAE_CONFIG:   $(FSUAE_CONFIG)"
	@echo "KICKSTART_FILE: $(KICKSTART_FILE)"
	@echo "SYSTEM_HDF:     $(SYSTEM_HDF)"
	@test -x "$(GCC_CC)" || (echo "Missing GCC: $(GCC_CC)" && exit 1)
	@test -x "$(GCC_STRIP)" || (echo "Missing strip: $(GCC_STRIP)" && exit 1)
	@test -x "$(GCC_OBJDUMP)" || (echo "Missing objdump: $(GCC_OBJDUMP)" && exit 1)
	@test -x "$(VAMOS)" || (echo "Missing vamos: $(VAMOS)" && exit 1)
	@test -d "$(SASC_PATH)" || (echo "Missing SAS/C path: $(SASC_PATH)" && exit 1)
	@test -x "$(FSUAE)" || (echo "Missing FS-UAE: $(FSUAE)" && exit 1)
	@test -f "$(KICKSTART_FILE)" || (echo "Missing Kickstart ROM: $(KICKSTART_FILE)" && exit 1)
	@test -f "$(SYSTEM_HDF)" || (echo "Missing AmigaOS HDF: $(SYSTEM_HDF)" && exit 1)
	@test -f ".vamosrc.in" || (echo "Missing .vamosrc.in" && exit 1)
	@test -f "$(FSUAE_TEMPLATE)" || (echo "Missing FS-UAE template: $(FSUAE_TEMPLATE)" && exit 1)
	@# Optional extras: reported, never fatal. A machine without a 1.3 ROM or
	@# hardfile is not broken -- it simply has no `gmake run-fsuae13`.
	@echo ""
	@echo "Optional (absent is fine):"
	@if [ -f "$(KICKSTART13_FILE)" ]; then s="found"; else s="absent -- no gmake run-fsuae13"; fi; \
		printf "  %-16s %s (%s)\n" "KICK 1.3 ROM:" "$(KICKSTART13_FILE)" "$$s"
	@if [ -f "$(SYSTEM13_HDF)" ]; then s="found"; else s="absent -- no gmake run-fsuae13"; fi; \
		printf "  %-16s %s (%s)\n" "AmigaOS 1.3 HDF:" "$(SYSTEM13_HDF)" "$$s"
	@# -f, not -x: these are AMIGA binaries run through vamos, so the host
	@# execute bit says nothing (Lha_40/Lha ships mode 644 and works fine).
	@if [ -f "$(BUMPREV)" ]; then s="found"; else s="absent -- no gmake release"; fi; \
		printf "  %-16s %s (%s)\n" "bumprev:" "$(BUMPREV)" "$$s"
	@if [ -f "$(AMIGA_LHA)" ]; then s="found"; else s="absent -- no gmake release-archive"; fi; \
		printf "  %-16s %s (%s)\n" "Amiga LhA:" "$(AMIGA_LHA)" "$$s"
	@if [ -x "$(XDFTOOL)" ]; then s="found"; else s="absent"; fi; \
		printf "  %-16s %s (%s)\n" "xdftool:" "$(XDFTOOL)" "$$s"

clean:
	rm -rf build dist

distclean: clean
	rm -f $(VAMOSRC)
	rm -rf fsuae/local

# push: publish the current dist/ to an SMB share. Depends on `all` so a stale
# tree is never published. Configure the share once with ./setup-smb.sh (writes
# the git-ignored smbpush.conf), or pass SMB_HOST=/SMB_SHARE= on the command
# line. If the share is already mounted (e.g. via Finder) that mount is reused;
# otherwise it is mounted on a temporary point and unmounted afterwards (an EXIT
# trap guarantees cleanup even if the copy fails). The copy is additive and uses
# cp -X so macOS extended attributes / resource forks (which SMB rejects) are
# not copied. Finder cruft (.DS_Store, AppleDouble "._*") is purged from dist/
# BEFORE the copy (cp -X strips xattrs but not those regular sidecar files) and
# from the TARGET drawer AFTER it -- the copy is additive, so cruft dropped on
# the share earlier (e.g. by Finder drag-copies) would otherwise stay there
# forever and show up as real files on the Amiga. macOS only.
push: all
	@if [ -z "$(SMB_HOST)" ] || [ -z "$(SMB_SHARE)" ]; then \
		echo "push: no SMB share configured."; \
		echo "  Run ./setup-smb.sh once, or pass SMB_HOST=... SMB_SHARE=... on the command line."; \
		exit 1; \
	fi
	@find dist \( -name '.DS_Store' -o -name '._*' \) -delete; \
	share="//$(SMB_HOST)/$(SMB_SHARE)"; \
	base=`mount | grep -iE "$(SMB_HOST)/$(SMB_SHARE) on .*smbfs" | head -1`; \
	if [ -n "$$base" ]; then \
		base="$${base#* on }"; base="$${base% (*}"; \
		echo "Reusing already-mounted $$share at $$base"; \
	else \
		user="$(SMB_USER)"; \
		if [ -z "$$user" ]; then printf "Samba user for $$share: "; read user; fi; \
		if [ -z "$$user" ]; then echo "ERROR: no Samba user given"; exit 1; fi; \
		base=`mktemp -d /tmp/$(PROJECT_NAME)-smb.XXXXXX` || exit 1; \
		trap 'umount "$$base" 2>/dev/null || diskutil unmount force "$$base" >/dev/null 2>&1; rmdir "$$base" 2>/dev/null' EXIT; \
		echo "Mounting $$share ..."; \
		mount_smbfs "//$$user@$(SMB_HOST)/$(SMB_SHARE)" "$$base" || { echo "ERROR: could not mount $$share as '$$user' (host reachable? password correct?)"; exit 1; }; \
	fi; \
	mkdir -p "$$base/$(SMB_DIR)" || { echo "ERROR: cannot create '$(SMB_DIR)' on the share"; exit 1; }; \
	echo "Copying dist/ -> $$share/$(SMB_DIR) ..."; \
	cp -RX dist/. "$$base/$(SMB_DIR)/" || { echo "ERROR: copy failed"; exit 1; }; \
	find "$$base/$(SMB_DIR)" \( -name '.DS_Store' -o -name '._*' \) -delete 2>/dev/null; \
	echo "Pushed $(PROJECT_NAME) to $$share/$(SMB_DIR)."
# =============================================================================
# Release packaging: an LhA archive, an ADF disk image, and an Aminet pair
# =============================================================================
#
#   gmake release-stage    -> build/release/  (the package tree; edit THIS one)
#   gmake release-drawer   -> dist/Release/   (the same tree, unpacked, on DEV:)
#   gmake release-archive  -> dist/<Project>.lha        (release-lha = synonym)
#   gmake release-aminet   -> dist/aminet/   (archive + .readme, NOT uploaded)
#   gmake release-verify   -> inspect the built archives for private state
#   gmake release-dist     -> archive + verify (no ADF here)
#
# ONLY `release-stage` is project-specific. Everything below it operates on
# whatever that target produced, so extending a project's package means editing
# one recipe. The version comes from `gmake release` (bumprev) -- these targets
# never bump; see the `release` target above.
#
# --- GLQuake test client -----------------------------------------------------
# A minigl.library ABI-5 dispatch client (GPL), built with its own makefile so
# its flags never mix with the project's. NOT part of this repository (the
# user, 2026-11-03: the repo holds the library, the installer, the tools and
# the demos): its source lives beside it, GLQUAKE_DIR. `glquake-data` copies
# the id1 paks from QUAKE_ID1 (default: the Quake data drawer) into
# dist/Quake/id1 -- 54 MB, never committed. See $(GLQUAKE_DIR)/README.md.
GLQUAKE_DIR ?= ../RadeonGL-GLQuake
.PHONY: glquake glquake-data clean-glquake
glquake glquake-data clean-glquake:
	@test -f "$(GLQUAKE_DIR)/Makefile.radeongl" || { echo "no GLQuake source in GLQUAKE_DIR=$(GLQUAKE_DIR) (not part of this repository)"; exit 2; }
	$(MAKE) -f $(GLQUAKE_DIR)/Makefile.radeongl QSRC=$(GLQUAKE_DIR) $@

# The GL core's modules (src/core): defined here, before the probe rules
# that list them as prerequisites (those expand when the Makefile is read).
CORE_MODULES    := core vram state matrix hwstate vertex texture get frame array
CORE_HDRS       := $(wildcard src/core/*.h)

# --- Probes: the day-one tools for the real machine (docs/probes.md) --------
# R200Info reads the Radeon's registers (never writes); BusBench measures
# MMIO and aperture costs; LockBench measures what a P96 bitmap lock does.
# The card comes from Picasso96 (p96board.c: a locked friend bitmap of the
# Workbench screen, the bases from p96GetBitMapAttr), and every register
# access happens inside such a lock (Picasso96, 2026-11-02;
# LockBench). openpci only cross-checks.
# GCC, -m68020 (the Mediator needs a 020 anyway). Binaries under
# dist/Probe/C, IconX scripts beside them, icons on the desktop.
P96_SDK ?= $(HOME)/Developer/AmigaSDK/Picasso96Develop
P96_INC := $(P96_SDK)/Include
PROBE_COMMON := mmio eclock plog pcicard r200probe p96board
PROBE_CFLAGS := $(GCC_WARNINGS) -Os -std=gnu99 -msasregparm -noixemul -m68020 \
                -fomit-frame-pointer -Isdk/openpci/include -I$(P96_INC) -Isrc/r200
PROBE_OBJS   := $(addprefix build/probe/,$(addsuffix .o,$(PROBE_COMMON)))
PROBE_HDRS   := $(wildcard src/probe/*.h) $(wildcard src/r200/*.h)
# CPRing runs the library's own ring code: src/r200 built with the probe flags
PROBE_R200      := r2cs r2emit r2ring r2cp r2ucode
PROBE_R200_OBJS := $(addprefix build/probe/r200/,$(addsuffix .o,$(PROBE_R200)))

# the CP microcode table, from the pinned linux-firmware file
src/r200/r2ucode.c: sdk/radeon-firmware/R200_cp.bin tools/gen_ucode.py
	$(PYTHON) -I tools/gen_ucode.py $< $@

build/probe/r200/%.o: src/r200/%.c $(PROBE_HDRS)
	@mkdir -p build/probe/r200
	$(GCC_CC) $(PROBE_CFLAGS) -c $< -o $@

# r2emit's float code (the viewport, never called by a probe) as FPU
# instructions: this toolchain's soft-float library lacks the int-to-float
# routines (__floatsisf, __floatunsisf).
build/probe/r200/r2emit.o: src/r200/r2emit.c $(PROBE_HDRS)
	@mkdir -p build/probe/r200
	$(GCC_CC) $(PROBE_CFLAGS) -m68881 -c $< -o $@

build/probe/%.o: src/probe/%.c $(PROBE_HDRS)
	@mkdir -p build/probe
	$(GCC_CC) $(PROBE_CFLAGS) -c $< -o $@

dist/Probe/C/R200Info: build/probe/r200info.o $(PROBE_OBJS)
	@mkdir -p dist/Probe/C
	$(GCC_CC) -noixemul $^ -o $@ -lamiga

dist/Probe/C/BusBench: build/probe/busbench.o $(PROBE_OBJS)
	@mkdir -p dist/Probe/C
	$(GCC_CC) -noixemul $^ -o $@ -lamiga

dist/Probe/C/LockBench: build/probe/lockbench.o $(PROBE_OBJS)
	@mkdir -p dist/Probe/C
	$(GCC_CC) -noixemul $^ -o $@ -lamiga

# BmFit: which bitmap shapes P96 places on the board (the texture heap)
dist/Probe/C/BmFit: build/probe/bmfit.o
	@mkdir -p dist/Probe/C
	$(GCC_CC) -noixemul $^ -o $@ -lamiga

# MemBench: fast RAM's streaming rates per region (read, write, copy, MOVE16)
dist/Probe/C/MemBench: build/probe/membench.o build/probe/eclock.o
	@mkdir -p dist/Probe/C
	$(GCC_CC) -noixemul $^ -o $@ -lamiga

# ExecMap: exec's functions by address (names the ROM in a PC profile)
dist/Probe/C/ExecMap: build/probe/execmap.o
	@mkdir -p dist/Probe/C
	$(GCC_CC) -noixemul $^ -o $@ -lamiga

# CxBreak quits the Blanker / DPMSManager commodities before a test
dist/Probe/C/CxBreak: build/probe/cxbreak.o
	@mkdir -p dist/Probe/C
	$(GCC_CC) -noixemul $^ -o $@ -lamiga

dist/Probe/C/CPRing: build/probe/cpring.o $(PROBE_OBJS) $(PROBE_R200_OBJS)
	@mkdir -p dist/Probe/C
	$(GCC_CC) -noixemul $^ -o $@ -lamiga

# Tri runs the GL core (float code): every object built as the library is,
# -m68060 -m68881 (the toolchain's soft-float library is incomplete), and
# the binary trap-checked for the 060.
TRI_CFLAGS   := $(GCC_WARNINGS) -Os -std=gnu99 -msasregparm -noixemul -m68060 -m68881 \
                -fomit-frame-pointer -fno-strict-aliasing -Isdk/openpci/include -I$(P96_INC) \
                -Isrc/r200 -Isrc/core -Isrc/probe
TRI_OBJS     := $(addprefix build/probe060/,$(addsuffix .o,$(PROBE_COMMON) tri triscene texscene)) \
                $(addprefix build/probe060/r200/,$(addsuffix .o,$(PROBE_R200) r2check)) \
                $(addprefix build/probe060/core/,$(addsuffix .o,$(CORE_MODULES)))

build/probe060/%.o: src/probe/%.c $(PROBE_HDRS) $(wildcard src/core/*.h)
	@mkdir -p build/probe060
	$(GCC_CC) $(TRI_CFLAGS) -c $< -o $@

build/probe060/r200/%.o: src/r200/%.c $(PROBE_HDRS)
	@mkdir -p build/probe060/r200
	$(GCC_CC) $(TRI_CFLAGS) -c $< -o $@

build/probe060/core/%.o: src/core/%.c $(PROBE_HDRS) $(wildcard src/core/*.h)
	@mkdir -p build/probe060/core
	$(GCC_CC) $(TRI_CFLAGS) -c $< -o $@

dist/Probe/C/Tri: $(TRI_OBJS)
	@mkdir -p dist/Probe/C
	$(GCC_CC) -noixemul -m68060 -m68881 $^ -o $@ -lamiga
	GCC_OBJDUMP=$(GCC_OBJDUMP) $(PYTHON) -I tools/check_fpu060.py $@

# SAS/C builds of the same sources: dist/Probe/C/<Tool>_sasc. Every link
# runs under tools/slink-guard: slink 6.57 under vamos can crash or hang in
# its exit path AFTER writing a complete executable (layout-dependent; met
# first by CxBreak_sasc, 2026-11-02). The P96
# headers are copied under build/ so vamos reaches them through proj:
# (it spins on a symlink out of a volume -- Herald). One vamos at a time:
# never run these with -j.
PROBE_SC_OBJS  := $(addprefix build/probe-sasc/,$(addsuffix .o,$(PROBE_COMMON)))
PROBE_SC_R200_OBJS := $(addprefix build/probe-sasc/r200/,$(addsuffix .o,$(PROBE_R200)))
PROBE_SC_IDIRS := IDIR=include: IDIR=proj:src/probe/ IDIR=proj:src/r200/ IDIR=proj:src/core/ IDIR=proj:sdk/openpci/include/ IDIR=proj:build/p96inc/

build/p96inc/.copied:
	rm -rf build/p96inc
	mkdir -p build
	cp -R "$(P96_INC)" build/p96inc
	touch $@

build/probe-sasc/%.o: src/probe/%.c $(PROBE_HDRS) build/p96inc/.copied | $(VAMOSRC)
	@mkdir -p build/probe-sasc
	$(VAMOS_SC) sc $(SC_OPTS) CPU=68020 OPTIMIZE NOLINK $(PROBE_SC_IDIRS) OBJNAME=proj:$@ proj:$<

build/probe-sasc/r200/%.o: src/r200/%.c $(PROBE_HDRS) | $(VAMOSRC)
	@mkdir -p build/probe-sasc/r200
	$(VAMOS_SC) sc $(SC_OPTS) CPU=68020 OPTIMIZE NOLINK $(PROBE_SC_IDIRS) OBJNAME=proj:$@ proj:$<

dist/Probe/C/R200Info_sasc: build/probe-sasc/r200info.o $(PROBE_SC_OBJS) | $(VAMOSRC)
	@mkdir -p dist/Probe/C
	tools/slink-guard $@ 120 $(VAMOS_SLINK) slink FROM lib:c.o $(addprefix proj:,$^) TO proj:$@ LIB lib:sc.lib lib:amiga.lib

dist/Probe/C/BusBench_sasc: build/probe-sasc/busbench.o $(PROBE_SC_OBJS) | $(VAMOSRC)
	@mkdir -p dist/Probe/C
	tools/slink-guard $@ 120 $(VAMOS_SLINK) slink FROM lib:c.o $(addprefix proj:,$^) TO proj:$@ LIB lib:sc.lib lib:amiga.lib

dist/Probe/C/LockBench_sasc: build/probe-sasc/lockbench.o $(PROBE_SC_OBJS) | $(VAMOSRC)
	@mkdir -p dist/Probe/C
	tools/slink-guard $@ 120 $(VAMOS_SLINK) slink FROM lib:c.o $(addprefix proj:,$^) TO proj:$@ LIB lib:sc.lib lib:amiga.lib

dist/Probe/C/BmFit_sasc: build/probe-sasc/bmfit.o | $(VAMOSRC)
	@mkdir -p dist/Probe/C
	tools/slink-guard $@ 120 $(VAMOS_SLINK) slink FROM lib:c.o $(addprefix proj:,$^) TO proj:$@ LIB lib:sc.lib lib:amiga.lib

dist/Probe/C/MemBench_sasc: build/probe-sasc/membench.o build/probe-sasc/eclock.o | $(VAMOSRC)
	@mkdir -p dist/Probe/C
	tools/slink-guard $@ 120 $(VAMOS_SLINK) slink FROM lib:c.o $(addprefix proj:,$^) TO proj:$@ LIB lib:sc.lib lib:amiga.lib

dist/Probe/C/ExecMap_sasc: build/probe-sasc/execmap.o | $(VAMOSRC)
	@mkdir -p dist/Probe/C
	tools/slink-guard $@ 120 $(VAMOS_SLINK) slink FROM lib:c.o $(addprefix proj:,$^) TO proj:$@ LIB lib:sc.lib lib:amiga.lib

dist/Probe/C/CxBreak_sasc: build/probe-sasc/cxbreak.o | $(VAMOSRC)
	@mkdir -p dist/Probe/C
	tools/slink-guard $@ 120 $(VAMOS_SLINK) slink FROM lib:c.o $(addprefix proj:,$^) TO proj:$@ LIB lib:sc.lib lib:amiga.lib

dist/Probe/C/CPRing_sasc: build/probe-sasc/cpring.o $(PROBE_SC_OBJS) $(PROBE_SC_R200_OBJS) | $(VAMOSRC)
	@mkdir -p dist/Probe/C
	tools/slink-guard $@ 120 $(VAMOS_SLINK) slink FROM lib:c.o $(addprefix proj:,$^) TO proj:$@ LIB lib:scm.lib lib:sc.lib lib:amiga.lib

# SAS/C Tri: the core objects of r200-objs (the same SC_OPTS), SAS/C's own
# software float (scm.lib)
dist/Probe/C/Tri_sasc: build/probe-sasc/tri.o build/probe-sasc/triscene.o build/probe-sasc/texscene.o $(PROBE_SC_OBJS) \
                       $(PROBE_SC_R200_OBJS) build/probe-sasc/r200/r2check.o \
                       $(addprefix build/core-sasc/,$(addsuffix .o,$(CORE_MODULES))) | $(VAMOSRC)
	@mkdir -p dist/Probe/C
	tools/slink-guard $@ 120 $(VAMOS_SLINK) slink FROM lib:c.o $(addprefix proj:,$^) TO proj:$@ LIB lib:scm.lib lib:sc.lib lib:amiga.lib

# The scripts write their report next to themselves (DEV:Probe/<Tool>.log),
# where the host reads it from the share afterwards. They run the GCC
# builds; the _sasc builds sit beside them in C/.
.PHONY: probes
probes: dist/Probe/C/R200Info dist/Probe/C/BusBench dist/Probe/C/CPRing dist/Probe/C/Tri dist/Probe/C/CxBreak \
        dist/Probe/C/LockBench dist/Probe/C/BmFit dist/Probe/C/ExecMap dist/Probe/C/MemBench \
        dist/Probe/C/R200Info_sasc dist/Probe/C/BusBench_sasc dist/Probe/C/CPRing_sasc dist/Probe/C/Tri_sasc \
        dist/Probe/C/CxBreak_sasc dist/Probe/C/LockBench_sasc dist/Probe/C/BmFit_sasc \
        dist/Probe/C/ExecMap_sasc dist/Probe/C/MemBench_sasc
	@printf '%s\n' '$(WB_ASSIGN_DEV)' > dist/Probe/R200Info
	@printf 'echo "R200Info: reading the Radeon (nothing is written). Move a window during the pause."\n' >> dist/Probe/R200Info
	@printf 'DEV:Probe/C/R200Info LOG=DEV:Probe/R200Info.log SAMPLES=2 INTERVAL=8\n' >> dist/Probe/R200Info
	@printf 'echo "Done. The report is DEV:Probe/R200Info.log"\n' >> dist/Probe/R200Info
	@printf '%s\n' '$(WB_ASSIGN_DEV)' > dist/Probe/BusBench
	@printf 'echo "BusBench: MMIO and aperture costs, 1 MB blocks (about a minute)."\n' >> dist/Probe/BusBench
	@printf 'DEV:Probe/C/BusBench LOG=DEV:Probe/BusBench.log\n' >> dist/Probe/BusBench
	@printf 'echo "Done. The report is DEV:Probe/BusBench.log"\n' >> dist/Probe/BusBench
	@printf '%s\n' '$(WB_ASSIGN_DEV)' > dist/Probe/CPRing
	@printf 'echo "CPRing: starts the Radeon command processor (microcode, a ring in VRAM, fences)."\n' >> dist/Probe/CPRing
	@printf 'echo "It writes CP registers and puts them back. A few seconds; keep Workbench quiet."\n' >> dist/Probe/CPRing
	@printf 'DEV:Probe/C/CPRing LOG=DEV:Probe/CPRing.log\n' >> dist/Probe/CPRing
	@printf 'echo "Done. The report is DEV:Probe/CPRing.log"\n' >> dist/Probe/CPRing
	@cp icons/run.info dist/Probe/R200Info.info
	@cp icons/run.info dist/Probe/BusBench.info
	@printf '%s\n' '$(WB_ASSIGN_DEV)' > dist/Probe/Tri
	@printf 'echo "Tri: the GL core draws three triangles with the R200 into VRAM and shows them."\n' >> dist/Probe/Tri
	@printf 'echo "It runs the command processor and the 3D engine for a moment; keep Workbench quiet."\n' >> dist/Probe/Tri
	@printf 'DEV:Probe/C/Tri LOG=DEV:Probe/Tri.log\n' >> dist/Probe/Tri
	@printf 'echo "Done. The report is DEV:Probe/Tri.log"\n' >> dist/Probe/Tri
	@printf '%s\n' '$(WB_ASSIGN_DEV)' > dist/Probe/LockBench
	@printf 'echo "LockBench: what a P96 bitmap lock does. A small window flickers for a few seconds."\n' >> dist/Probe/LockBench
	@printf 'echo "It reads Radeon registers inside locks and writes none. Keep Workbench quiet."\n' >> dist/Probe/LockBench
	@printf 'DEV:Probe/C/LockBench LOG=DEV:Probe/LockBench.log\n' >> dist/Probe/LockBench
	@printf 'echo "Done. The report is DEV:Probe/LockBench.log"\n' >> dist/Probe/LockBench
	@cp icons/run.info dist/Probe/CPRing.info
	@cp icons/run.info dist/Probe/Tri.info
	@cp icons/run.info dist/Probe/LockBench.info
	@touch dist/.backdrop
	@grep -q '^Probe/R200Info$$' dist/.backdrop || printf 'Probe/R200Info\nProbe/BusBench\n' >> dist/.backdrop
	@grep -q '^Probe/CPRing$$' dist/.backdrop || printf 'Probe/CPRing\n' >> dist/.backdrop
	@grep -q '^Probe/Tri$$' dist/.backdrop || printf 'Probe/Tri\n' >> dist/.backdrop
	@grep -q '^Probe/LockBench$$' dist/.backdrop || printf 'Probe/LockBench\n' >> dist/.backdrop
	@echo "probes: staged DEV:Probe/R200Info + BusBench + CPRing + Tri + LockBench (scripts, icons, C/)"

# --- minigl.library, census back end (docs/census.md) ------------------------
# Draws nothing; counts what a dispatch-ABI-5 client asks for. The table is
# generated from the SDK header (tools/gen_dispatch.py), so every slot has the
# SDK's exact signature. GCC only, -nostdlib, and NO -msasregparm: clients
# call the table with GCC's stack convention. shell.o links first.
MGL_SDK_INC   := sdk/minigl-29.1/minigl-shared-library/include
MGL_DISPATCH  := $(MGL_SDK_INC)/libraries/minigl_dispatch.h
CENSUS_HOOKS  := GLBegin,GLEnd,GLVertex2fv,GLVertex3fv,GLVertex4f,GLVertex4fv,GLTexCoord2f,GLTexCoord2fv,GLTexCoord4f,GLTexCoord4fv,GLMultiTexCoord2fARB,GLMultiTexCoord2fvARB,GLColor3fv,GLColor3ubv,GLColor4f,GLColor4fv,GLColor4ub,GLColor4ubv,GLNormal3f,GLNormal3fv,GLArrayElement,GLEnableClientState,GLDisableClientState,GLClientActiveTextureARB,GLLockArrays,GLUnlockArrays,GLDrawElements,GLDrawArrays,GLMultiDrawArrays,GLGenTextures,GLIsTexture,GLBindTexture,GLActiveTextureARB,GLTexImage2D,GLTexSubImage2D,GLClear,GLGetString,GLGetIntegerv,GLGetFloatv,GLGetBooleanv,GLIsEnabled,MGLCreateContext,MGLDeleteContext,MGLSwitchDisplay,MGLGetWindowHandle,MGLGetInputWindowHandle,MGLLockDisplay,MGLResizeContext
LIB_CFLAGS    := -Wall -Wextra -Wno-pointer-sign -Werror=implicit-function-declaration \
                 -O2 -fno-peephole2 -fomit-frame-pointer -fno-builtin -m68020 -noixemul \
                 -I$(MGL_SDK_INC) -Ilib -Ibuild/lib
CENSUS_OBJS   := build/lib/shell.o build/lib/census.o build/lib/census_dispatch.o
CENSUS_LIB    := dist/Libs/Census/minigl.library

build/lib/census_dispatch.c build/lib/census_dispatch.h: $(MGL_DISPATCH) tools/gen_dispatch.py Makefile
	@mkdir -p build/lib
	$(PYTHON) -I tools/gen_dispatch.py $(MGL_DISPATCH) build/lib/census_dispatch \
	    --prefix Cen_ --count Cen_Hit --include census.h --hooks $(CENSUS_HOOKS)

build/lib/%.o: lib/%.c lib/census.h lib/backend.h build/lib/census_dispatch.h
	@mkdir -p build/lib
	$(GCC_CC) $(LIB_CFLAGS) -c $< -o $@

build/lib/census_dispatch.o: build/lib/census_dispatch.c lib/census.h
	$(GCC_CC) $(LIB_CFLAGS) -Wno-unused-parameter -c $< -o $@

$(CENSUS_LIB): $(CENSUS_OBJS)
	@mkdir -p $(dir $@)
	$(GCC_CC) -nostdlib -nostartfiles -nodefaultlibs -noixemul -m68020 -o $@ $(CENSUS_OBJS) -lgcc

.PHONY: census-lib
census-lib: $(CENSUS_LIB)

# --- R200 packet layer: emitter, ring, checker (src/r200, docs/r200-packets.md)
# Pure C89 without OS calls: the library and the probes link it. `gmake test`
# runs it on the Mac against test/host/shim (32-bit ULONG) and a simulated CP
# (test/host/simcp.c); `gmake r200-objs` builds it with both Amiga compilers.
R200_MODULES    := r2cs r2emit r2ring r2check r2cp r2ucode
R200_HDRS       := $(wildcard src/r200/*.h)
HOSTCC          ?= cc
# -ffp-contract=off: the 68k FPU has no fused multiply-add, and the host
# compiler fuses a * b + c by default (arm64), which rounds differently
HOST_MOD_CFLAGS := -O2 -std=c89 -pedantic -Wall -Wextra -Werror -fno-strict-aliasing -ffp-contract=off
HOST_TST_CFLAGS := -O2 -std=c99 -Wall -Wextra -Werror -ffp-contract=off
HOST_INC        := -Itest/host/shim -Isrc/r200 -Itest/host
HOST_R200_OBJS  := $(addprefix build/host/,$(addsuffix .o,$(R200_MODULES)))

build/host/%.o: src/r200/%.c $(R200_HDRS)
	@mkdir -p build/host
	$(HOSTCC) $(HOST_MOD_CFLAGS) $(HOST_INC) -c $< -o $@

build/host/%.o: test/host/%.c $(R200_HDRS) $(wildcard src/core/*.h) $(wildcard test/host/*.h) src/probe/triscene.h src/probe/texscene.h
	@mkdir -p build/host
	$(HOSTCC) $(HOST_TST_CFLAGS) $(HOST_INC) -Isrc/probe -c $< -o $@

build/host/test_r200: build/host/test_r200.o build/host/simcp.o $(HOST_R200_OBJS)
	$(HOSTCC) $^ -o $@

# The GL core (src/core, decision D2: our own, C89 without OS calls) on the
# same terms: host-tested down to the packets it emits.
HOST_CORE_OBJS  := $(addprefix build/host/core_,$(addsuffix .o,$(CORE_MODULES)))
HOST_INC        += -Isrc/core

build/host/core_%.o: src/core/%.c $(CORE_HDRS) $(R200_HDRS)
	@mkdir -p build/host
	$(HOSTCC) $(HOST_MOD_CFLAGS) $(HOST_INC) -c $< -o $@

# the Tri probe's scene, rendered on the Mac by test_sim
build/host/triscene.o: src/probe/triscene.c src/probe/triscene.h $(CORE_HDRS) $(R200_HDRS)
	@mkdir -p build/host
	$(HOSTCC) $(HOST_MOD_CFLAGS) $(HOST_INC) -Isrc/core -c $< -o $@

build/host/texscene.o: src/probe/texscene.c src/probe/texscene.h src/probe/triscene.h $(CORE_HDRS) $(R200_HDRS)
	@mkdir -p build/host
	$(HOSTCC) $(HOST_MOD_CFLAGS) $(HOST_INC) -Isrc/core -c $< -o $@

# GLBench's patterns on the host, for a native profiler (not part of `test`)
build/host/bench_core: build/host/bench_core.o $(HOST_CORE_OBJS) $(HOST_R200_OBJS)
	$(HOSTCC) $^ -o $@

build/host/test_core: build/host/test_core.o build/host/simcp.o $(HOST_CORE_OBJS) $(HOST_R200_OBJS)
	$(HOSTCC) $^ -o $@

# The reference rasteriser (test/host/r200sim.c, concept 10.3): frames you
# can look at, build/host/sim-*.ppm.
build/host/test_sim: build/host/test_sim.o build/host/r200sim.o build/host/triscene.o build/host/texscene.o $(HOST_CORE_OBJS) $(HOST_R200_OBJS)
	$(HOSTCC) $^ -o $@

# r200view DUMP.r2d OUT.ppm: a GLQuake frame dumped by the library
# (RadeonGLDump=N) rendered on the Mac.
build/host/r200view: build/host/r200view.o build/host/r200sim.o
	$(HOSTCC) $^ -o $@

.PHONY: test
test: build/host/test_r200 build/host/test_core build/host/test_sim build/host/r200view
	./build/host/test_r200
	./build/host/test_core
	./build/host/test_sim

R200_GCC_CFLAGS := $(GCC_WARNINGS) -O2 -std=gnu99 -m68020 -noixemul -fomit-frame-pointer -fno-strict-aliasing -Isrc/r200
R200_GCC_OBJS   := $(addprefix build/r200-gcc/,$(addsuffix .o,$(R200_MODULES)))
R200_SC_OBJS    := $(addprefix build/r200-sasc/,$(addsuffix .o,$(R200_MODULES)))

build/r200-gcc/%.o: src/r200/%.c $(R200_HDRS)
	@mkdir -p build/r200-gcc
	$(GCC_CC) $(R200_GCC_CFLAGS) -c $< -o $@

build/r200-sasc/%.o: src/r200/%.c $(R200_HDRS) | $(VAMOSRC)
	@mkdir -p build/r200-sasc
	$(VAMOS_SC) sc $(SC_OPTS) CPU=68020 OPTIMIZE NOLINK IDIR=include: IDIR=proj:src/r200/ OBJNAME=proj:$@ proj:$<

CORE_GCC_OBJS   := $(addprefix build/core-gcc/,$(addsuffix .o,$(CORE_MODULES)))
CORE_SC_OBJS    := $(addprefix build/core-sasc/,$(addsuffix .o,$(CORE_MODULES)))

.PHONY: r200-objs
r200-objs: $(R200_GCC_OBJS) $(R200_SC_OBJS) $(CORE_GCC_OBJS) $(CORE_SC_OBJS)

build/core-gcc/%.o: src/core/%.c $(CORE_HDRS) $(R200_HDRS)
	@mkdir -p build/core-gcc
	$(GCC_CC) $(R200_GCC_CFLAGS) -Isrc/core -c $< -o $@

build/core-sasc/%.o: src/core/%.c $(CORE_HDRS) $(R200_HDRS) | $(VAMOSRC)
	@mkdir -p build/core-sasc
	$(VAMOS_SC) sc $(SC_OPTS) CPU=68020 OPTIMIZE NOLINK IDIR=include: IDIR=proj:src/r200/ IDIR=proj:src/core/ OBJNAME=proj:$@ proj:$<

# --- minigl.library, RadeonGL back end (docs/core.md, lib/rgl.c) -------------
# Milestone 2: the real core, emitter and ring writer behind the dispatch
# table, with the null card (lib/nullcard.c) in place of a Radeon: every
# packet the GPU would read goes through the checker; nothing is drawn.
# The implemented slots are the Hook_ functions defined in lib/rgl.c (read
# out of the source, so list and code cannot drift); every other slot is a
# stub that records GL_INVALID_OPERATION and the slot name for the log.
# -m68060 -m68881 together (without -m68881 GCC 6.5 falls back to soft float).
RGL_LIB    := dist/Libs/RadeonGL/minigl.library
RGL_HOOKS  := ${shell sed -n 's/^[A-Za-z].*[ *]Hook_\([A-Za-z0-9_]*\)(.*/\1/p' lib/rgl.c | sort -u | paste -sd, -}
RGL_CFLAGS := -Wall -Wextra -Wno-pointer-sign -Werror=implicit-function-declaration \
              -O2 -fno-peephole2 -fomit-frame-pointer -fno-builtin -fno-tree-loop-distribute-patterns \
              -fno-strict-aliasing -m68060 -m68881 -DRGL_CPU_040 -noixemul -I$(MGL_SDK_INC) -Ilib -Ibuild/rgl \
              -Isrc/core -Isrc/r200 -I$(P96_INC)
RGL_OBJS   := build/rgl/shell.o build/rgl/rgl.o build/rgl/nullcard.o build/rgl/card.o build/rgl/runtime.o \
              build/rgl/rgl_dispatch.o \
              $(addprefix build/rgl/core_,$(addsuffix .o,$(CORE_MODULES))) \
              $(addprefix build/rgl/r2_,$(addsuffix .o,$(R200_MODULES)))

build/rgl/rgl_dispatch.c build/rgl/rgl_dispatch.h: $(MGL_DISPATCH) tools/gen_dispatch.py lib/rgl.c Makefile
	@mkdir -p build/rgl
	$(PYTHON) -I tools/gen_dispatch.py $(MGL_DISPATCH) build/rgl/rgl_dispatch \
	    --prefix Rgl_ --direct Rgl_Unimpl --flags 0 --context '&Rgl_CurrentContext' \
	    --include rgl.h --hooks $(RGL_HOOKS)

build/rgl/%.o: lib/%.c lib/backend.h lib/rgl.h lib/nullcard.h lib/card.h build/rgl/rgl_dispatch.h $(CORE_HDRS) $(R200_HDRS) \
               src/RadeonGL_rev.h
	@mkdir -p build/rgl
	$(GCC_CC) $(RGL_CFLAGS) -c $< -o $@

build/rgl/rgl_dispatch.o: build/rgl/rgl_dispatch.c lib/rgl.h
	$(GCC_CC) $(RGL_CFLAGS) -Wno-unused-parameter -c $< -o $@

build/rgl/core_%.o: src/core/%.c $(CORE_HDRS) $(R200_HDRS)
	@mkdir -p build/rgl
	$(GCC_CC) $(RGL_CFLAGS) -c $< -o $@

build/rgl/r2_%.o: src/r200/%.c $(R200_HDRS)
	@mkdir -p build/rgl
	$(GCC_CC) $(RGL_CFLAGS) -c $< -o $@

$(RGL_LIB): $(RGL_OBJS)
	@mkdir -p $(dir $@)
	$(GCC_CC) -nostdlib -nostartfiles -nodefaultlibs -noixemul -m68060 -m68881 -o $@ $(RGL_OBJS) -lgcc \
	    -Wl,-Map=build/rgl/minigl.map
	GCC_OBJDUMP=$(GCC_OBJDUMP) $(PYTHON) -I tools/check_fpu060.py $@

.PHONY: rgl-lib
rgl-lib: $(RGL_LIB)

# --- The 68020/68030 build (with a 68881/68882) ------------------------------
# The same sources for a CPU whose FPU lacks the 68040's single- and double-
# rounding instructions (fsmove, fsmul, fdadd ...: some 450 of them in the
# build above). The Installer offers it (the user, 2026-11-03); without
# RGL_CPU_040 the shell refuses a CPU below the 68020 or without an FPU, the
# build above one below the 68040 (lib/shell.c). tools/check_fpu881.py
# proves none of those instructions slipped in.
RGL030_LIB    := dist/Libs/RadeonGL030/minigl.library
RGL030_CFLAGS := $(filter-out -DRGL_CPU_040,$(subst -m68060,-m68030,$(RGL_CFLAGS)))
RGL030_OBJS   := $(patsubst build/rgl/%,build/rgl030/%,$(RGL_OBJS))

build/rgl030/%.o: lib/%.c lib/backend.h lib/rgl.h lib/nullcard.h lib/card.h build/rgl/rgl_dispatch.h $(CORE_HDRS) \
                  $(R200_HDRS) src/RadeonGL_rev.h
	@mkdir -p build/rgl030
	$(GCC_CC) $(RGL030_CFLAGS) -c $< -o $@

build/rgl030/rgl_dispatch.o: build/rgl/rgl_dispatch.c lib/rgl.h
	@mkdir -p build/rgl030
	$(GCC_CC) $(RGL030_CFLAGS) -Wno-unused-parameter -c $< -o $@

build/rgl030/core_%.o: src/core/%.c $(CORE_HDRS) $(R200_HDRS)
	@mkdir -p build/rgl030
	$(GCC_CC) $(RGL030_CFLAGS) -c $< -o $@

build/rgl030/r2_%.o: src/r200/%.c $(R200_HDRS)
	@mkdir -p build/rgl030
	$(GCC_CC) $(RGL030_CFLAGS) -c $< -o $@

$(RGL030_LIB): $(RGL030_OBJS)
	@mkdir -p $(dir $@)
	$(GCC_CC) -nostdlib -nostartfiles -nodefaultlibs -noixemul -m68030 -m68881 -o $@ $(RGL030_OBJS) -lgcc \
	    -Wl,-Map=build/rgl030/minigl.map
	GCC_OBJDUMP=$(GCC_OBJDUMP) $(PYTHON) -I tools/check_fpu881.py $@

rgl-lib: $(RGL030_LIB)

# --- GLSmoke: a small MiniGL client for the first runs on the card ----------
# (glsmoke/glsmoke.c, docs/design-card-backend.md step 5). GCC only: it links
# the MiniGL SDK's import library, as GLQuake does. dist/GLSmoke holds the
# program, the library in Libs/, and an IconX script that adds Libs/ to LIBS:
# for the run (Avail FLUSH first: a resident minigl.library would be reused).
GLSMOKE := dist/GLSmoke/GLSmoke

$(GLSMOKE): glsmoke/glsmoke.c
	@mkdir -p dist/GLSmoke
	$(GCC_CC) -std=gnu99 -noixemul -m68060 -m68881 -O2 -Wall -Wextra -Wno-pointer-sign \
	    -I$(MGL_SDK_INC) -o $@ $< -Lsdk/minigl-29.1/lib -lminigl -lm -lamiga
	GCC_OBJDUMP=$(GCC_OBJDUMP) $(PYTHON) -I tools/check_fpu060.py $@

# GLSmoke for the 68030 library's drawer (-m68030: its one 68040 FPU
# instruction would trap there)
GLSMOKE030 := dist/For030/C/GLSmoke

$(GLSMOKE030): glsmoke/glsmoke.c
	@mkdir -p $(dir $@)
	$(GCC_CC) -std=gnu99 -noixemul -m68030 -m68881 -DRGL_FOR_030 -O2 -Wall -Wextra -Wno-pointer-sign \
	    -I$(MGL_SDK_INC) -o $@ $< -Lsdk/minigl-29.1/lib -lminigl -lm -lamiga
	GCC_OBJDUMP=$(GCC_OBJDUMP) $(PYTHON) -I tools/check_fpu881.py $@

GLBENCH := dist/GLSmoke/GLBench

$(GLBENCH): glsmoke/glbench.c glsmoke/pcprof.c glsmoke/pcprof.h
	@mkdir -p dist/GLSmoke
	$(GCC_CC) -std=gnu99 -noixemul -m68060 -m68881 -O2 -Wall -Wextra -Wno-pointer-sign \
	    -I$(MGL_SDK_INC) -o $@ glsmoke/glbench.c glsmoke/pcprof.c -Lsdk/minigl-29.1/lib -lminigl -lm -lamiga
	GCC_OBJDUMP=$(GCC_OBJDUMP) $(PYTHON) -I tools/check_fpu060.py $@

.PHONY: glsmoke
glsmoke: $(GLSMOKE) $(GLBENCH) $(RGL_LIB)
	@mkdir -p dist/GLSmoke/Libs
	@cp $(RGL_LIB) dist/GLSmoke/Libs/minigl.library
	@printf '%s\n' '$(WB_ASSIGN_DEV)' > dist/GLSmoke/RunGLSmoke
	@printf 'echo "GLSmoke: 300 frames through minigl.library (RadeonGL), then the frame rate."\n' >> dist/GLSmoke/RunGLSmoke
	@printf 'Avail >NIL: FLUSH\n' >> dist/GLSmoke/RunGLSmoke
	@printf 'Assign LIBS: DEV:GLSmoke/Libs ADD\n' >> dist/GLSmoke/RunGLSmoke
	@printf 'SetEnv RadeonGLLog DEV:GLSmoke/glsmoke-lib.log\n' >> dist/GLSmoke/RunGLSmoke
	@printf 'DEV:GLSmoke/GLSmoke\n' >> dist/GLSmoke/RunGLSmoke
	@printf 'Assign LIBS: DEV:GLSmoke/Libs REMOVE\n' >> dist/GLSmoke/RunGLSmoke
	@printf 'UnSetEnv RadeonGLLog\n' >> dist/GLSmoke/RunGLSmoke
	@printf 'echo "Done. The library log is DEV:GLSmoke/glsmoke-lib.log"\n' >> dist/GLSmoke/RunGLSmoke
	@cp icons/run.info dist/GLSmoke/RunGLSmoke.info
	@echo "glsmoke: staged DEV:GLSmoke (GLSmoke, Libs/minigl.library, RunGLSmoke)"

