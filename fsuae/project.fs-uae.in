[fs-uae]
amiga_model = A1200/020
kickstart_file = @KICKSTART_FILE@

# 68030 (rather than the A1200's stock 68EC020) so an MMU is available --
# needed for MuForce/MuGuardianAngel-style memory debugging. FS-UAE's
# uae_mmu_model defaults to 68030 automatically whenever cpu=68030, so no
# separate MMU option is needed; the line below is just explicit about it.
cpu = 68030
uae_mmu_model = 68030

# Exposes the emulated serial port as a TCP socket instead of a real/host
# device, so MuForce output (or any other serial debug output) can be
# read by telnetting into it: `telnet 127.0.0.1 1234`. See
# https://blog.arisamiga.rocks/post/debuggingamiga/
serial_port = tcp://127.0.0.1:1234

hard_drive_0 = @SYSTEM_HDF@
hard_drive_0_label = System

hard_drive_1 = @PROJECT_DIST@
hard_drive_1_label = DEV

chip_memory = 2048
fast_memory = 8192

graphics_card = uaegfx-z3
graphics_card_memory = 16

floppy_drive_0_sounds = off
floppy_drive_1_sounds = off
floppy_drive_2_sounds = off
floppy_drive_3_sounds = off

window_width = 960
window_height = 720
fullscreen = 0

automatic_input_grab = 1
cursor = 1
initial_input_grab = 1
mouse_integration = 0
joystick_port_1 = nothing
bsdsocket_library = 1

title = AmigaOS 3.2 - @PROJECT_NAME@